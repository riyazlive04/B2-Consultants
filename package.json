{
  "name": "b2-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "test": "node --conditions=react-server --import tsx --test \"src/**/__tests__/*.test.ts\"",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "db:local": "node scripts/local-db.mjs start",
    "db:local:stop": "node scripts/local-db.mjs stop",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:supabase": "node scripts/migrate-to-supabase.mjs",
    "db:lockdown": "node scripts/migrate-to-supabase.mjs --lockdown-only",
    "email:preflight": "node --env-file=.env scripts/resend-preflight.mjs",
    "db:backup": "node --env-file=.env scripts/backup-verify.mjs",
    "db:backup:dump-only": "node --env-file=.env scripts/backup-verify.mjs --no-verify",
    "backfill:opps": "node --conditions=react-server --import tsx scripts/backfill-opportunities.ts",
    "sample:invoice": "node -e \"process.env.TSX_TSCONFIG_PATH='tsconfig.scripts.json';require('child_process').execFileSync(process.execPath,['--import','tsx','scripts/sample-invoice.ts'],{stdio:'inherit',env:process.env})\"",
    "db:seed": "tsx prisma/seed.ts",
    "db:ledger": "tsx prisma/seed-ledger.ts",
    "db:verify-ledger": "tsx prisma/verify-ledger.ts",
    "db:sample": "tsx prisma/sample-data.ts",
    "db:demo": "tsx prisma/demo-data.ts",
    "db:workshops": "tsx prisma/seed-workshops.ts",
    "db:crm": "node --conditions=react-server --import tsx prisma/seed-crm.ts",
    "db:pipeline-sync": "node --conditions=react-server --import tsx scripts/sync-pipeline-stages.ts",
    "db:training-page": "tsx prisma/seed-training-page.ts",
    "db:snippets": "tsx prisma/seed-snippets.ts",
    "wire:cta": "node --conditions=react-server --import tsx scripts/wire-cta-popup.ts",
    "db:link-bookings": "tsx prisma/backfill-booking-links.ts",
    "verify:zoom": "node --conditions=react-server --import tsx scripts/zoom-selftest.ts",
    "demo:agreement-docs": "node -e \"process.env.TSX_TSCONFIG_PATH='tsconfig.scripts.json';require('child_process').execFileSync(process.execPath,['--import','tsx','scripts/make-demo-agreement-docs.ts'],{stdio:'inherit',env:process.env})\"",
    "verify:agreement-live": "node --conditions=react-server --import tsx scripts/verify-agreement-live.ts",
    "verify:agreement-docs": "node -e \"process.env.TSX_TSCONFIG_PATH='tsconfig.scripts.json';require('child_process').execFileSync(process.execPath,['--import','tsx','scripts/verify-agreement-docs.ts'],{stdio:'inherit',env:process.env})\"",
    "verify:outreach": "tsx prisma/verify-outreach.ts",
    "verify:automation": "tsx prisma/verify-automation.ts",
    "docs:whatsapp": "tsx scripts/whatsapp-templates-docx.ts",
    "docs:whatsapp:utility": "tsx scripts/wati-templates-utility-docx.ts",
    "docs:whatsapp:batch": "tsx scripts/wati-templates-utility-docx.ts --batch",
    "docs:whatsapp:all": "tsx scripts/wati-templates-utility-docx.ts --all",
    "docs:whatsapp:action": "tsx scripts/wati-templates-utility-docx.ts --action",
    "e2e:builder": "tsx scripts/e2e-funnel-builder.ts",
    "guide:shots": "node --conditions=react-server --import tsx scripts/capture-guide-shots.ts",
    "migration:audit": "node --conditions=react-server --import tsx scripts/migration-audit.ts",
    "fix:level-codes": "node --conditions=react-server --import tsx scripts/fix-curriculum-level-codes.ts",
    "smoke": "node --conditions=react-server --import tsx scripts/smoke-screens.ts",
    "pdfjs:worker": "node -e \"require('fs').copyFileSync('node_modules/pdfjs-dist/build/pdf.worker.min.mjs','public/pdfjs/pdf.worker.min.mjs')\"",
    "wire:pipeline": "node --conditions=react-server --import tsx scripts/wire-form-pipeline.ts",
    "demo:agreement-templates": "node --import tsx scripts/make-sample-templates.ts",
    "demo:agreement-templates:seed": "node -e \"process.env.TSX_TSCONFIG_PATH='tsconfig.scripts.json';require('child_process').execFileSync(process.execPath,['--import','tsx','scripts/seed-sample-templates.ts'],{stdio:'inherit',env:process.env})\""
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@react-pdf/renderer": "^4.5.1",
    "better-auth": "^1.6.23",
    "bullmq": "^5.79.2",
    "docx": "^9.7.1",
    "ioredis": "^5.11.1",
    "libphonenumber-js": "^1.13.8",
    "lucide-react": "^1.23.0",
    "mammoth": "^1.12.0",
    "next": "14.2.5",
    "papaparse": "^5.5.4",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^6.4.299",
    "prisma": "^6.19.3",
    "react": "^18",
    "react-dom": "^18",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.5",
    "playwright": "^1.62.1",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
