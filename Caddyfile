# Plain-HTTP reverse proxy for the B2 app. TLS is terminated upstream by the host's
# shared Traefik instance (ports 80/443 are already owned by other services on this
# VPS) — Traefik forwards to this Caddy on its published 8080 port over HTTP, so
# auto-HTTPS must stay OFF here or Caddy would try to redirect/issue its own cert
# and loop against Traefik's termination.

{
	auto_https off
}

http://{$APP_DOMAIN} {
	encode zstd gzip

	# X-Forwarded-Proto / -Host are set by Traefik (not this Caddy) before the request
	# reaches app:3000 — users-actions.ts and better-auth rely on those headers to
	# build https links and infer secure cookies. See traefik-dynamic/b2.yml.
	reverse_proxy app:3000 {
		health_uri /api/health
		health_interval 30s
		health_timeout 10s
	}

	# Access log to stdout → `docker compose logs caddy`.
	log {
		output stdout
		format console
	}
}
