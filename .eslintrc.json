{
  "extends": "next/core-web-vitals",
  // TODO(design-system): add eslint-plugin-tailwindcss (rule `no-custom-classname`, allowlisting
  // the project's own token classes: text-display-l|h1|h2|h3|metric|body|body-strong|label|
  // caption|mono-data, on-accent, etc.) to ban raw `text-white` and Tailwind arbitrary-value
  // classes (`text-\[...\]`) outside src/components/ui/**. See docs/DESIGN_SYSTEM.md §2.1 and
  // §1.4 — this is the exact class of bug fixed in the §13 design-token sweep (BUILD_CHECKLIST.md).
  // Not added now because it is a new npm dependency (requires `npm install` / package.json
  // changes) which this workstream is scoped to avoid; wire it up in a pass that owns tooling deps.
  "overrides": [
    {
      // src/documents/** is the @react-pdf/renderer tree, not the DOM.
      //
      // Its <Image> is react-pdf's PDF primitive, which takes `src` and `style` and has no
      // `alt` prop at all - a PDF has no alt text. `jsx-a11y/alt-text` is a DOM rule matching
      // on the component's NAME, so it fired eleven times on the agreement documents. The
      // "fix" it asks for would pass an unknown prop into the PDF renderer, so the honest
      // resolution is to scope a DOM rule to the DOM.
      //
      // Deliberately narrow: only this rule, only this directory. Everything else - including
      // every real <img> and next/image in src/app and src/components - is still checked.
      "files": ["src/documents/**/*.tsx"],
      "rules": {
        "jsx-a11y/alt-text": "off"
      }
    }
  ]
}
