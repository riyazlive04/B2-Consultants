// B2 Consultants Founder Dashboard - FULL 3-PHASE SCHEMA (scoped upfront in Phase 0).
// Phase 1: Finance + Pipeline · Phase 2: People + Students · Phase 3: Funnel + Cash Health.
// Rules baked in (CONTEXT §6):
//  - Money is stored as integer minor units (paise / cents) in BigInt, INR and EUR side by side,
//    with the FX rate used stamped on each record.
//  - Ingestable entities carry `source` + `manualOverride` + `externalRef` (de-dupe).
//  - Audit tables (MilestoneLog, SignalChangeLog, DailyLog, LeadStageHistory) are APPEND-ONLY:
//    no update/delete is exposed at the service layer, ever.
//  - Dates stored UTC, displayed IST DD/MM/YYYY (presentation concern).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime queries use DATABASE_URL (on Neon: the pooled -pooler endpoint).
  // Migrations (`prisma migrate deploy`) use DIRECT_URL - Neon's direct, non-pooled
  // endpoint - because migrate needs session-level advisory locks PgBouncer can't hold.
  // Locally both point at the same Docker Postgres (see .env).
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ───────────────────────────── Auth (Better Auth) ─────────────────────────────

enum Role {
  ADMIN // Ameen - everything
  HEAD // Karthick - own daily log, view-only Students
  USER // Asma / Nilofer - own daily log + own pipeline entry
  STUDENT // portal login linked to ONE Student record - sees only their own journey
  TUTOR // German Note tutor - GN section only (batches they teach + community)
}

// A suspended account cannot sign in, and its live sessions are deleted the moment
// it is suspended - the badge in Users & access is not decorative.
enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id            String     @id
  name          String
  email         String     @unique
  emailVerified Boolean    @default(false)
  image         String?
  role          Role       @default(USER)
  status        UserStatus @default(ACTIVE)
  // O4 - forced password change. Set true when an ADMIN sets someone's password (they picked it,
  // so the owner must replace it); cleared the moment the user changes it. Invited users choose
  // their own password on acceptance, so they are never flagged. `requireSession` bounces any
  // flagged user to /change-password before an app route renders.
  mustChangePassword Boolean @default(false)
  /// Part 2 §13: "dark and light per user" - the founder prefers dark, others may not.
  /// SYSTEM defers to the OS setting, which is why it is the default rather than LIGHT:
  /// a fresh account should follow the machine, not impose one person's taste.
  themePreference ThemePreference @default(SYSTEM)
  /// Slots this user owned that somebody else covered (Part 2 §7.1).
  discoveriesCoveredForMe DiscoveryOutcome[] @relation("DiscoveryCoveredFor")
  // Per-user feature overrides (Admin-managed): { "finance": true, "students": false, … }.
  // Missing key → the role's default access applies. Admins always see everything.
  sectionAccess Json?
  // Per-user capability overrides: { "finance.write": true, … }. What they may DO, as
  // opposed to which screens they may open. See src/lib/capabilities.ts.
  capabilities  Json?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  sessions                 Session[]
  accounts                 Account[]
  workDays                 WorkDay[]          @relation("WorkDayUser")
  teamProfile              TeamProfile?
  /// Terminations this person carried out. SetNull like every other actor link - an admin
  /// leaving must not erase the record of who offboarded whom.
  terminationsPerformed    TeamProfile[]      @relation("TeamProfileTerminatedBy")
  studentProfile           Student?           @relation("StudentAccount")
  incomesEntered           Income[]           @relation("IncomeEnteredBy")
  expensesEntered          Expense[]          @relation("ExpenseEnteredBy")
  leadsEntered             Lead[]             @relation("LeadEnteredBy")
  leadsAssigned            Lead[]             @relation("LeadAssignedTo")
  outcomesEntered          DiscoveryOutcome[] @relation("OutcomeEnteredBy")
  callsLogged              CallLog[]          @relation("CallLoggedBy")
  stageChanges             LeadStageHistory[] @relation("StageChangedBy")
  slotsAssigned            AppointmentSlot[]  @relation("SlotAssignedTo")
  dailyLogs                DailyLog[]
  milestoneLogUpdates      MilestoneLog[]     @relation("MilestoneUpdatedBy")
  signalChanges            SignalChangeLog[]  @relation("SignalChangedBy")
  sprintWeeksEntered       SprintWeek[]       @relation("SprintEnteredBy")
  rewardGrantsDecided      RewardGrant[]      @relation("RewardGrantDecidedBy")
  invite                   UserInvite?        @relation("UserInviteFor")
  invitesCreated           UserInvite[]       @relation("UserInviteCreatedBy")
  gnBatchesTutored         Batch[]            @relation("BatchTutor")
  tutorFeesEarned          TutorFee[]         @relation("TutorFeeEarner")
  gnRecordingsPosted       GnRecording[]      @relation("GnRecordingPostedBy")
  gnRecordingWatches       GnRecordingWatch[] @relation("GnRecordingWatchUser")
  gnEventsCreated          ClassSession[]     @relation("GnEventCreatedBy")
  attendanceMarked         SessionAttendance[] @relation("AttendanceMarkedBy")
  gnPosts                  GnPost[]           @relation("GnPostAuthor")
  gnComments               GnComment[]        @relation("GnCommentAuthor")
  gnLikes                  GnLike[]           @relation("GnLikeUser")
  gnCommentLikes           GnCommentLike[]    @relation("GnCommentLikeUser")
  telecallerPayoutsEntered TelecallerPayout[] @relation("TelecallerPayoutEnteredBy")
  whatsappMessagesSent     WhatsAppMessage[]  @relation("WhatsAppSentBy")
  agreementsIssued         Agreement[]        @relation("AgreementIssuedBy")
  journalEntriesPosted     JournalEntry[]     @relation("JournalEntryPostedBy")
  periodLocksSet           PeriodLock[]       @relation("PeriodLockedBy")
  auditEntries             AuditEntry[]       @relation("AuditActor")
  activityLogged           ActivityLog[]      @relation("ActivityActor")
  // Synamate CRM (Phase 1)
  companiesOwned           Company[]          @relation("CompanyOwner")
  contactNotes             ContactNote[]      @relation("NoteAuthor")
  tasksAssigned            ContactTask[]      @relation("TaskAssignee")
  tasksCreated             ContactTask[]      @relation("TaskCreatedBy")
  opportunitiesOwned       Opportunity[]      @relation("OppOwner")
  // Synamate Sites (Phase 2)
  formsCreated             Form[]             @relation("FormCreatedBy")
  funnelsCreated           Funnel[]           @relation("FunnelCreatedBy")
  snippetsCreated  SectionSnippet[] @relation("SnippetCreatedBy")
  // Sites - the marketing website
  sitesCreated             Site[]             @relation("SiteCreatedBy")
  sitePageRevisions        SitePageRevision[] @relation("SitePageRevisionBy")
  mediaUploaded            MediaAsset[]       @relation("MediaUploadedBy")
  // Synamate Payments (Phase 3)
  invoicesCreated          Invoice[]          @relation("InvoiceCreatedBy")
  invoicePaymentsRecorded  InvoicePayment[]   @relation("InvoicePaymentRecordedBy")
  // Synamate Conversations (Phase 4)
  messagesSent             Message[]          @relation("MessageSentBy")
  messagesAssigned         Message[]          @relation("MessageAssignedTo")
  // Synamate Automation (Phase 5)
  workflowsCreated         Workflow[]         @relation("WorkflowCreatedBy")
  // Outreach Specialist SOP
  outreachStepsActed       OutreachStepLog[]  @relation("OutreachStepActedBy")
  outreachQualified        OutreachJourney[]  @relation("OutreachQualifiedBy")
  outreachTouchpoints      OutreachJourney[]  @relation("OutreachRespTouchpoint")
  outreachDiscos           OutreachJourney[]  @relation("OutreachRespDisco")
  enrollmentsClosed        Enrollment[]       @relation("EnrollmentCloser")
  sssSlotsOwned            SssSlot[]          @relation("SssSlotOwner")
  // Soft-delete authorship: records this user archived (see src/lib/soft-delete.ts)
  leadsArchived            Lead[]             @relation("LeadArchivedBy")
  companiesArchived        Company[]          @relation("CompanyArchivedBy")
  opportunitiesArchived    Opportunity[]      @relation("OpportunityArchivedBy")
  tasksArchived            ContactTask[]      @relation("ContactTaskArchivedBy")
  incomesArchived          Income[]           @relation("IncomeArchivedBy")
  expensesArchived         Expense[]          @relation("ExpenseArchivedBy")
  invoicesArchived         Invoice[]          @relation("InvoiceArchivedBy")
  pendingPaymentsArchived  PendingPayment[]   @relation("PendingPaymentArchivedBy")
  productsArchived         Product[]          @relation("ProductArchivedBy")

  @@map("user")
}

/// Per-user work time, one row per IST calendar day (`day` is UTC-midnight, the
/// project-wide @db.Date encoding - see src/lib/dates.ts).
///
/// Deliberately NOT append-only: the client heartbeats elapsed seconds every
/// ~30s and the server ADDS them to today's row, so this table is updated in
/// place all day long. Keep it out of the `append_only_guards` trigger list.
///
/// `seconds` is the source of truth for the dashboard's day/week widget; the
/// browser holds only an unflushed remainder. That is what makes history
/// survive a new device, a cleared browser or a re-login.
model WorkDay {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("WorkDayUser", fields: [userId], references: [id], onDelete: Cascade)
  day       DateTime @db.Date
  seconds   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, day])
  @@index([userId, day])
  @@map("work_day")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// ───────────────────────────── Shared enums ─────────────────────────────

// Ingest provenance (CONTEXT §4). MANUAL is the guaranteed core; everything else is additive.
// Wave-1 (Synamate in-sourcing): BOOKING_FORM = our own public booking page;
// META_LEAD_AD / FLEXIFUNNELS = the two external lead-capture webhooks that replace
// Synamate's lead inbox. SYNAMATE stays only so historical imported rows keep their tag.
//
// Source answers "which pipe carried this row to us", NOT "where did the human come from" -
// that is LeadSource. PABBLY is a relay: it fans the same opt-in out to Synamate and to us,
// so a PABBLY row's LeadSource is whatever origin the payload declares (Meta ad, IG, …).
enum Source {
  MANUAL
  SYNAMATE
  RAZORPAY
  SHEET
  FATHOM
  BOOKING_FORM
  META_LEAD_AD
  FLEXIFUNNELS
  NATIVE_FORM // Phase 2: our own hosted forms / funnel opt-ins (Synamate Sites parity)
  PABBLY // Pabbly Connect relay → /api/leads/pabbly (runs alongside Synamate)
}

// ── Program / course levels ────────────────────────────────────────────────
// Was `enum ProgramLevel { SOLO GUIDED ELITE GN_A1..GN_B2 GN_BUNDLE OTHER }`. Now a
// CONFIG TABLE (`Level`) so the founders can add German levels (C1, C2, …) and bundles from
// the admin dashboard instead of shipping a migration each time (docs/CONFIGURABLE_LEVELS_PLAN.md).
//
// The level columns below (Income.programLevel, Enrollment.programLevel, Lead.wonLevel,
// GnBatch.level, GnPendingJoiner.level, BookOrder.level, PendingPayment.programLevel) store the
// `Level.code` as text - the SAME values the old enum held ("GN_A1", "SOLO"), so the migration is a
// verbatim enum→text cast with no data change. `code` is treated as an immutable natural key;
// server actions validate a submitted code against the active Level rows.
enum LevelKind {
  COACHING_TIER // SOLO / GUIDED / ELITE - B2 coaching tiers; seeded + locked, not user-editable
  GERMAN_LEVEL // GN_A1 … GN_C2 - the German course levels the founders add
  GERMAN_BUNDLE // GN_BUNDLE / A1_A2 … - composed of GERMAN_LEVELs
  OTHER
}

// The configurable level/tier catalogue. One row per sellable level or bundle.
model Level {
  id     String    @id @default(cuid())
  code   String    @unique // stable key stored on every level column: "GN_A1", "SOLO", "GN_C1"
  label  String // display: "GN A1"
  kind   LevelKind
  order  Int       @default(0) // display order within a kind
  active Boolean   @default(true)
  locked Boolean   @default(false) // coaching tiers: code/kind immutable, not deletable

  /// Which GL income account this level's revenue posts to (chart-of-accounts code). German levels
  /// default to "4030" (Income - German Note); overridable per level. Never null → posting is safe.
  incomeAccountCode String @default("4030")

  /// German-Note economics, integer paise. Null for coaching tiers / OTHER.
  booksCostInrMinor BigInt?
  tutorCostInrMinor BigInt?

  /// Bundle composition - ordered member `code`s, only for kind = GERMAN_BUNDLE.
  bundleMembers String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind, active, order])
  @@map("level")
}

enum Signal {
  GREEN
  AMBER
  RED
}

// ───────────────────────────── Phase 1 - Finance ─────────────────────────────

enum PaymentType {
  FULL_PAYMENT
  INSTALMENT
}

enum PaymentMethod {
  BANK_TRANSFER_INR
  BANK_TRANSFER_EUR
  PAYPAL
  RAZORPAY
  CASH
  UPI
  CREDIT_CARD
  OTHER
}

enum ExpenseCategory {
  MARKETING
  TOOLS_SOFTWARE
  TEAM_SALARIES
  CONTENT_CREATION
  EVENTS_OFFLINE
  OPERATIONS
  COGS_DIRECT_DELIVERY
  OTHER
}

enum PendingPaymentStatus {
  ACTIVE
  PAID_IN_FULL
  OVERDUE
  DROPPED
}

/// Which business a cost belongs to (§1.4). Income derives its line from the programme
/// level, but a Meta Ads invoice or the office rent names no programme, so an expense has
/// to be told. SHARED is the default and is apportioned across both lines by revenue share
/// - only costs that genuinely belong to ONE business should be tagged B2 or GERMAN_NOTE.
enum ExpenseBusinessLine {
  B2
  GERMAN_NOTE
  SHARED
}

// Daily income entry (PRD1 §4.2). Admin-only.
model Income {
  id             String        @id @default(cuid())
  date           DateTime      @db.Date
  studentName    String
  // Optional links - how Finance feeds Student LTV (CONTEXT §7). Never required in Phase 1.
  studentId      String?
  student        Student?      @relation(fields: [studentId], references: [id], onDelete: SetNull)
  enrollmentId   String?
  enrollment     Enrollment?   @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  amountInrMinor BigInt        @default(0) // paise
  amountEurMinor BigInt        @default(0) // cents
  fxRateUsed     Decimal       @db.Decimal(14, 6) // INR per 1 EUR on entry date
  programLevel   String // Level.code (was ProgramLevel enum)
  paymentType    PaymentType
  paymentMethod  PaymentMethod
  // Instalment plan details - asked only when paymentType = INSTALMENT. The count is how many
  // instalments the fee is split into; the extras are the surcharge added for choosing the plan
  // (informational - the received amounts above stay the money that actually arrived).
  instalmentCount         Int?
  instalmentExtraInrMinor BigInt @default(0) // paise
  instalmentExtraEurMinor BigInt @default(0) // cents
  notes          String?
  source         Source        @default(MANUAL)
  manualOverride Boolean       @default(false)
  externalRef    String? // e.g. Razorpay payment id - de-dupe key for ingest
  enteredById    String?
  enteredBy      User?         @relation("IncomeEnteredBy", fields: [enteredById], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?
  deletedById    String?
  deletedBy      User?         @relation("IncomeArchivedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  @@unique([source, externalRef])
  @@index([date])
  @@index([studentId])
  @@index([programLevel, date])
  @@index([deletedAt])
  @@map("income")
}

// Daily expense entry (PRD1 §4.3). Admin-only.
model Expense {
  id             String          @id @default(cuid())
  date           DateTime        @db.Date
  amountInrMinor BigInt          @default(0)
  amountEurMinor BigInt          @default(0)
  fxRateUsed     Decimal         @db.Decimal(14, 6)
  category       ExpenseCategory
  isCogs         Boolean         @default(false)
  /// Defaults to SHARED so every pre-existing row keeps behaving exactly as it did before
  /// this column existed (apportioned by revenue share) - the split only sharpens as costs
  /// are actually tagged, and never silently reattributes history.
  businessLine   ExpenseBusinessLine @default(SHARED)
  vendor         String
  notes          String?
  source         Source          @default(MANUAL)
  manualOverride Boolean         @default(false)
  externalRef    String?
  enteredById    String?
  enteredBy      User?           @relation("ExpenseEnteredBy", fields: [enteredById], references: [id], onDelete: SetNull)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?
  deletedById    String?
  deletedBy      User?           @relation("ExpenseArchivedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  @@unique([source, externalRef])
  @@index([date])
  @@index([isCogs, date])
  @@index([deletedAt])
  @@map("expense")
}

// Pending payments tracker (PRD1 §4.4). "Amount paid so far" is COMPUTED at read time
// by summing Income rows linked to the same student - never stored, never double-entered.
model PendingPayment {
  id               String               @id @default(cuid())
  studentName      String
  studentId        String?
  student          Student?             @relation(fields: [studentId], references: [id], onDelete: SetNull)
  /// ER v2 `ENROLLMENT ||--|| EMI_PLAN` (Track E). PendingPayment + Instalment already IS the
  /// EMI plan; what it lacked was the link saying which enrollment it bills.
  enrollmentId     String?
  enrollment       Enrollment?          @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  programLevel     String // Level.code (was ProgramLevel enum)
  /// ER v2 EMI_PLAN.num_emis / levels_taken. INPUTS the founder sets when building the plan
  /// (the spec's "2 EMIs per level" rule), not outputs - which is why they are stored rather
  /// than counted off Instalment rows that may not all exist yet.
  numEmis          Int?
  levelsTaken      Int?
  totalFeeInrMinor BigInt               @default(0)
  totalFeeEurMinor BigInt               @default(0)
  /// The surcharge for paying in instalments, priced per plan length in the Founder Console
  /// (AppSetting "instalmentPlans"). Kept SEPARATE from totalFee so the agreed fee keeps its
  /// original meaning - "total to collect" is fee + this, computed, never a restated fee.
  /// Snapshotted when the plan is generated: re-pricing the table must not silently move the
  /// balance on a plan the student already signed up to.
  planExtraInrMinor BigInt              @default(0)
  planExtraEurMinor BigInt              @default(0)
  /// Days between instalments used to build this plan's schedule - stored so the plan can be
  /// explained ("every 30 days") after the config default has since changed.
  intervalDays     Int?
  fxRateUsed       Decimal              @db.Decimal(14, 6)
  nextDueDate      DateTime?            @db.Date
  status           PendingPaymentStatus @default(ACTIVE)
  notes            String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  deletedAt        DateTime?
  deletedById      String?
  deletedBy        User?                @relation("PendingPaymentArchivedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  whatsappMessages WhatsAppMessage[]
  instalments      Instalment[]

  @@index([status, nextDueDate])
  @@index([enrollmentId])
  @@index([deletedAt])
  @@map("pending_payment")
}

// ── Structured EMI schedule (spec Module G) ─────────────────────────
// The per-instalment rows the aggregate PendingPayment had no home for: 1 level = 2
// EMIs, 3 levels = 6, each with its own amount, due date, paid date and status.
// PendingPayment.nextDueDate stays as the headline "next due" the dashboards read.
enum InstalmentStatus {
  DUE
  PAID
  OVERDUE
}

model Instalment {
  id               String           @id @default(cuid())
  pendingPaymentId String
  pendingPayment   PendingPayment   @relation(fields: [pendingPaymentId], references: [id], onDelete: Cascade)
  seq              Int // 1-based instalment number
  amountInrMinor   BigInt           @default(0) // paise
  amountEurMinor   BigInt           @default(0) // cents
  fxRateUsed       Decimal          @db.Decimal(14, 6)
  dueDate          DateTime         @db.Date
  paidDate         DateTime?        @db.Date
  status           InstalmentStatus @default(DUE)
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  dunningEvents    DunningEvent[]

  @@unique([pendingPaymentId, seq])
  @@index([status, dueDate])
  @@map("instalment")
}

/// The rungs of the payment-chase ladder.
///
/// UPCOMING is a nudge before the due date, MISSED is the first chase after it, FINAL is the
/// last automated word before a human takes over. Named for what they mean to the student, not
/// "stage 1/2/3" - the offsets are founder-configurable, so a numeric name would stop matching
/// the day someone moves one.
enum DunningStage {
  UPCOMING
  MISSED
  FINAL
}

/// One rung, sent once.
///
/// WHY THIS TABLE EXISTS: the single reminder this replaced deduped by string-matching its own
/// subject line against the Message table (`subject: { startsWith: "Payment reminder" }`). That
/// works right up until someone rewords a subject, at which point every student who ever received
/// the old wording is chased again. Whether a rung has been climbed is a fact, and facts belong
/// in a row.
///
/// The unique key is what makes the ladder safe to run on any cadence: a stage that has fired
/// cannot fire twice, so the daily cron, a manual run and a retry after a crash all converge on
/// the same outcome.
model DunningEvent {
  id           String       @id @default(cuid())
  instalmentId String
  instalment   Instalment   @relation(fields: [instalmentId], references: [id], onDelete: Cascade)
  stage        DunningStage
  /// EMAIL / WHATSAPP / BOTH, as configured for the stage at the time it fired. Snapshotted
  /// rather than read live, because "why did this go by email" must stay answerable after the
  /// config changes.
  channel      String
  sentAt       DateTime     @default(now())
  /// Whether anything actually left the building. A stage recorded with `delivered: false` still
  /// blocks a re-send - the ladder moved on, and re-chasing on a Resend outage would flood a
  /// student the moment service came back.
  delivered    Boolean      @default(false)
  /// The Message row, when there was one. Null when the channel was off and the send was skipped.
  messageId    String?
  note         String?

  @@unique([instalmentId, stage])
  @@index([sentAt])
  @@map("dunning_event")
}

// Monthly revenue target for the Pipeline target bar (PRD1 §5.4). Default ₹8,00,000.
model MonthlyTarget {
  id             String   @id @default(cuid())
  month          DateTime @unique @db.Date // first day of month, UTC
  targetInrMinor BigInt   @default(80000000)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("monthly_target")
}

// ───────────────────────────── Phase 1 - Pipeline ─────────────────────────────

enum LeadSource {
  INSTAGRAM
  YOUTUBE
  LINKEDIN
  WHATSAPP
  REFERRAL
  SUMMIT
  WORKSHOP
  META_ADS // Meta Lead Ads webhook (Wave-1 capture)
  LANDING_PAGE // FlexiFunnels / website opt-in webhook (Wave-1 capture)
  GHOSTED_BLUEPRINT // Phase 3 attribution tag (PRD3 §3.4) - scoped now, used later
  OTHER
}

enum LeadStage {
  NEW_LEAD
  // The SOP's early funnel, given columns of their own on the board (06/08/2026). Before this,
  // every lead from opt-in until a DISCO was booked sat in "Pre-Qualified & Confirmed", so the
  // busiest part of the funnel was invisible.
  WHATSAPP_SENT
  STRATEGY_CALL_BOOKED
  DISCO_BOOKED
  DISCO_NOT_BOOKED
  DISCO_COMPLETED
  SSS_BOOKED
  SSS_COMPLETED
  PROPOSAL_SENT
  // Synamate pipeline parity (client notes, bucket-1): the workshop branch and the
  // post-offer money trail between "proposal" and "won".
  SENT_TO_WORKSHOP
  WORKSHOP_FOLLOWUP
  OFFER_FOLLOWUP // offer made, didn't buy - follow-up running
  DEPOSIT_FOLLOWUP // agreed, no deposit yet - follow-up running
  DEPOSIT_PAID // confirmed signup with deposit
  WON
  LOST
  NO_SHOW
}

// How a won/deposit deal pays (Synamate "Split Pay / Full Pay").
enum PaymentPlan {
  SPLIT_PAY
  FULL_PAY
}

model Lead {
  id             String        @id @default(cuid())
  name           String
  // Nullable since the Synamate import (16 Jul): 5,886 of 23,432 imported contacts have
  // no phone at all - 5,086 of those have no email either. Every code path that sends
  // (WATI/WhatsApp, the Outreach SOP ladder) MUST null-check before dialling.
  phone          String?
  email          String? // captured from booking form / ad lead (Wave-1)
  city           String?
  industry       String?
  leadSource     LeadSource
  dateIn         DateTime      @db.Date
  stage          LeadStage     @default(NEW_LEAD)
  wonLevel       String? // Level.code; set when stage → WON; feeds "conversions by level" (PRD1 §5.4)
  paymentPlan    PaymentPlan? // set from DEPOSIT_PAID onward - split pay vs full pay
  notes          String?
  source         Source        @default(MANUAL) // ingest provenance (Synamate / sheet / capture)
  manualOverride Boolean       @default(false)
  externalRef    String?
  utm            Json? // captured UTM params from the ad / landing source (Wave-1)
  /// The hostname this contact came in through - "optin.b2consultants.de", lower-cased, no port.
  ///
  /// Observed, never inferred: it is the Host header of the request that actually created them,
  /// recorded by the public funnel form and the booking form. Anything we could not observe stays
  /// NULL, and NULL means "we do not know", not "none" - the WhatsApp domain gate reads it that
  /// way and lets an unknown origin through, because the 23,429 leads imported from Synamate can
  /// never have one and blocking them would silence every reminder in the system.
  originDomain   String?
  // Speed-to-lead (Synamate "Who" + "Speed Ratio"): who owns the lead and when it was
  // first contacted. Speed = contactedAt − createdAt, computed at read time.
  assignedToId   String?
  assignedTo     User?         @relation("LeadAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  contactedAt    DateTime?
  /// ER v2 `MARKETING_SOURCE ||--o{ LEAD` (Track F). `leadSource` above stays as the coarse
  /// CHANNEL; this is the campaign beneath it. SetNull - retiring a campaign must not orphan
  /// or delete the leads it produced.
  marketingSourceId String?
  marketingSource   MarketingSource? @relation(fields: [marketingSourceId], references: [id], onDelete: SetNull)
  enteredById    String?
  enteredBy      User?         @relation("LeadEnteredBy", fields: [enteredById], references: [id], onDelete: SetNull)

  /// ── BANT AT OPT-IN ────────────────────────────────────────────────────────────────
  /// The band score as of the LANDING PAGE, not the booking.
  ///
  /// Application Logic §4.3 specifies two scoring stages - "at opt-in, the moment answers are
  /// captured, so unqualified leads never enter outreach" and again at booking. Only the second
  /// was ever built: BANT lived solely on `BookingRequest`, which only the in-app /book form
  /// creates. A landing-page lead relayed by Pabbly therefore arrived with its qualification
  /// answers in the payload and nowhere to put them, so every downstream consumer - the SOP's
  /// Qualified verdict, Key Metrics, the pipeline ranking, the discovery specialist's screen -
  /// saw an unscored lead. These columns are that missing home.
  ///
  /// ALL NULLABLE, including the four dimension booleans, on purpose. `BookingRequest` defaults
  /// them to `false`, which is safe there because a row only exists once a form was submitted.
  /// Here, most leads will never be scored at all, and "we have no evidence for Budget" must not
  /// read as "they have no budget" - that distinction decides who gets called.
  bantBudget    Boolean?
  bantAuthority Boolean?
  bantNeed      Boolean?
  bantTimeline  Boolean?
  bantScore     Int?
  bantAvg       Float?
  bantVerdict   BantVerdict?
  bantScoredAt  DateTime?
  bantSource    BantSource?
  /// The qualification answers exactly as the sender posted them, before any mapping.
  ///
  /// This is the evidence, and it is also the debugging surface: when a landing-page question is
  /// reworded and stops matching the catalogue, the raw keys are still here, so Console can show
  /// the founder which fields arrived unrecognised instead of the score silently reading 0.
  intakeAnswers Json?

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?
  deletedById    String?
  deletedBy      User?         @relation("LeadArchivedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  outcomes            DiscoveryOutcome[]
  callLogs            CallLog[]
  stageHistory        LeadStageHistory[]
  students            Student[]
  bookings            BookingRequest[]
  outreachJourney     OutreachJourney?
  whatsappMessages    WhatsAppMessage[]
  agreements          Agreement[]
  // Synamate CRM (Phase 1): the Lead is the Contact record.
  tags                Tag[]                @relation("LeadTags")
  companyId           String?
  company             Company?             @relation(fields: [companyId], references: [id], onDelete: SetNull)
  customFields        Json? // values keyed by CustomFieldDefinition.key (object = CONTACT)
  contactNotes        ContactNote[]
  tasks               ContactTask[]
  opportunities       Opportunity[]
  formSubmissions     FormSubmission[]
  invoices            Invoice[]
  subscriptions       Subscription[]
  messages            Message[]
  workflowEnrollments WorkflowEnrollment[]
  consents            ConsentRecord[]
  answers             LeadAnswer[]
  enrollments         Enrollment[]           @relation("EnrollmentLead")
  workshopRegistrations WorkshopRegistration[]

  @@unique([source, externalRef])
  @@index([stage])
  @@index([dateIn])
  @@index([leadSource])
  @@index([assignedToId])
  // The L1 desk's working set is "my open leads, newest first" and its month targets are "my
  // leads created this month" - both filter on assignedToId AND range/order on createdAt. The
  // single-column assignedToId index above could only narrow to the owner and then had to sort
  // the remainder, which after the 23,430-lead hand-out is most of the table per caller.
  @@index([assignedToId, createdAt])
  @@index([companyId])
  @@index([marketingSourceId])
  @@index([deletedAt])
  @@map("lead")
}

// APPEND-ONLY. Written automatically on every stage change - gives Phase 1 its
// "calls booked this month" counts and Phase 3 its "proposals sent this week" pulls.
model LeadStageHistory {
  id          String     @id @default(cuid())
  leadId      String
  lead        Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  fromStage   LeadStage?
  toStage     LeadStage
  changedAt   DateTime   @default(now())
  changedById String?
  changedBy   User?      @relation("StageChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([toStage, changedAt])
  @@map("lead_stage_history")
}

enum CallOutcome {
  QUALIFIED_FOR_SSS
  NOT_QUALIFIED_FOR_SSS
  FOLLOW_UP_NEEDED
  NO_SHOW
  SENT_TO_WORKSHOP
}

// Discovery call outcome (PRD1 §5.3), entered by Asma, linked to a lead.
model DiscoveryOutcome {
  id              String      @id @default(cuid())
  leadId          String
  lead            Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  callDate        DateTime    @db.Date
  outcome         CallOutcome
  highlyQualified Boolean     @default(false) // feeds "Highly qualified rate %" (PRD1 §5.4)
  // BANT qualification (report §3.A) - Asma marks these after the call; drives priority score
  bantBudget      Boolean     @default(false)
  bantAuthority   Boolean     @default(false)
  bantNeed        Boolean     @default(false)
  bantTimeline    Boolean     @default(false)
  sssDate         DateTime?   @db.Date
  /// Part 2 §7.1: a stand-in ran this call in someone else's slot. When set, THIS leg's
  /// commission splits substitutePct to the stand-in (enteredById) and the rest to the slot's
  /// owner (this user). Null = nobody covered; the leg pays whole, as it always has.
  coveredForId    String?
  coveredFor      User?       @relation("DiscoveryCoveredFor", fields: [coveredForId], references: [id], onDelete: SetNull)
  notes           String? // key notes to closer
  source          Source      @default(MANUAL)
  manualOverride  Boolean     @default(false)
  externalRef     String?
  enteredById     String?
  enteredBy       User?       @relation("OutcomeEnteredBy", fields: [enteredById], references: [id], onDelete: SetNull)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([source, externalRef])
  @@index([callDate])
  @@map("discovery_outcome")
}

// What actually happened on ONE dial. Distinct from CallOutcome, which grades a completed
// discovery CONVERSATION - this grades the attempt, including the attempts that never connected.
enum CallLogOutcome {
  SPOKE // connected and talked - the only outcome that counts as "client spoken to"
  NO_ANSWER
  BUSY
  CALLBACK // asked to be called back later
  WRONG_NUMBER
  NOT_INTERESTED
}

/// One row per dial attempt: (who × which lead × when × what happened).
///
/// Why this exists: before it, "calls made" came only from DailyLog - a self-reported
/// aggregate the telecaller typed in themselves, with no link to a lead. Nothing recorded
/// that a specific person rang a specific number, so "which of my leads still need a call
/// today?" was unanswerable. This is the append-only fact behind the telecaller desk.
///
/// Append-only by intent: a mis-logged call is corrected with another row, never edited,
/// so the count can't be silently rewritten after the fact (same rule as DailyLog).
model CallLog {
  id        String         @id @default(cuid())
  leadId    String
  lead      Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  // Who dialled. SetNull (not Cascade): deleting a user must never delete the call history
  // that their commission and the team's counts were computed from.
  userId    String?
  user      User?          @relation("CallLoggedBy", fields: [userId], references: [id], onDelete: SetNull)
  calledAt  DateTime       @default(now())
  outcome   CallLogOutcome
  notes     String?
  createdAt DateTime       @default(now())

  // ── Offline capture ────────────────────────────────────────────────────────
  // A telecaller on a phone loses signal mid-shift and keeps working; the outcome is
  // queued on the device and posted when the connection returns. `calledAt` then holds
  // the DEVICE's clock - the only record of when the call actually happened - which is
  // the one place in this app a client-supplied timestamp is trusted at all.
  //
  // That trust is bounded, and deliberately visible:
  //   • `syncedAt` is the SERVER's receipt instant. Non-null means "this row arrived after
  //     the fact, and `calledAt` came from the device". Null means it was logged live and
  //     `calledAt` is server-stamped as it always was.
  //   • `clientKey` is generated on the device and unique, so a retry, a double-tap or two
  //     tabs flushing the same queue collapse to ONE row instead of inflating the counts.
  //
  // Why it matters: `calledAt` drives the 5-minute connection rate on the L1 desk - a JD
  // target people are reviewed against. Without `syncedAt` a device clock set back an hour
  // would silently manufacture a "connected in 4 minutes" that nobody could later disprove.
  // With it, every late row carries its own evidence.
  clientKey String?   @unique
  syncedAt  DateTime?

  // [userId, calledAt] serves "my calls today"; [leadId, calledAt] serves "when was this
  // lead last called" - the two questions the desk asks on every load.
  @@index([userId, calledAt])
  @@index([leadId, calledAt])
  @@index([calledAt])
  @@map("call_log")
}

// ═══════════════ Synamate CRM parity - Phase 1 (SYNAMATE_CLONE_SPEC §5) ═══════════════
// Brings GoHighLevel/Synamate's Contacts + Opportunities into B2. The Lead IS the Contact;
// these models add tags, user-defined custom fields, notes, tasks, company grouping, and a
// proper Opportunity/Pipeline board. The seeded "Sales" pipeline mirrors the LeadStage enum
// and write-throughs to Lead.stage, so existing pipeline/funnel/reminder logic is untouched.

/// Freeform contact tag (Synamate "Tags"). Names stored lowercased+trimmed; implicit m-n to Lead.
model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String? // optional design-token key; falls back to a hashed default in the UI
  createdAt DateTime @default(now())
  leads     Lead[]   @relation("LeadTags")

  @@map("tag")
}

enum CustomFieldType {
  TEXT
  LONG_TEXT
  NUMBER
  DATE
  DROPDOWN
  MULTI_SELECT
  CHECKBOX
  PHONE
  EMAIL
  URL
  MONETARY
}

enum CustomFieldObject {
  CONTACT
  OPPORTUNITY
  COMPANY
}

/// User-defined custom field (Synamate "Custom Fields"). Values live as a JSON blob on the
/// owning record (Lead.customFields / Company.customFields), keyed by `key`.
model CustomFieldDefinition {
  id        String            @id @default(cuid())
  object    CustomFieldObject @default(CONTACT)
  name      String
  key       String // slug, unique per object
  fieldType CustomFieldType   @default(TEXT)
  options   Json? // string[] for DROPDOWN / MULTI_SELECT
  position  Int               @default(0)
  createdAt DateTime          @default(now())

  @@unique([object, key])
  @@map("custom_field_definition")
}

/// B2B org grouping (Synamate "Companies"). One company → many contacts.
model Company {
  id           String    @id @default(cuid())
  name         String
  domain       String?
  phone        String?
  email        String?
  address      String?
  city         String?
  country      String?
  ownerId      String?
  owner        User?     @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  customFields Json?
  deletedAt    DateTime?
  deletedById  String?
  deletedBy    User?     @relation("CompanyArchivedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  leads Lead[]

  @@index([ownerId])
  @@index([deletedAt])
  @@map("company")
}

/// Contact "Notes" tab. The activity timeline is a read-time merge of these + LeadStageHistory
/// + WhatsAppMessage + DiscoveryOutcome + BookingRequest + completed ContactTasks.
model ContactNote {
  id            String       @id @default(cuid())
  leadId        String
  lead          Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  // Optional: a note can also be tagged to one specific deal, so an Opportunity has its own
  // conversation instead of everything being forced onto the parent Lead (BUILD_CHECKLIST.md §3).
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  body          String
  pinned        Boolean      @default(false)
  createdById   String?
  createdBy     User?        @relation("NoteAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([leadId, createdAt])
  @@index([opportunityId, createdAt])
  @@map("contact_note")
}

enum TaskStatus {
  OPEN
  COMPLETED
}

/// Contacts › Tasks (Synamate "Tasks"). May attach to a contact or stand alone.
model ContactTask {
  id           String     @id @default(cuid())
  leadId       String?
  lead         Lead?      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  title        String
  body         String?
  dueAt        DateTime?
  status       TaskStatus @default(OPEN)
  completedAt  DateTime?
  assignedToId String?
  assignedTo   User?      @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdById  String?
  createdBy    User?      @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?
  deletedById  String?
  deletedBy    User?      @relation("ContactTaskArchivedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  @@index([status, dueAt])
  @@index([leadId])
  @@index([assignedToId, status])
  @@index([deletedAt])
  @@map("contact_task")
}

enum OpportunityStatus {
  OPEN
  WON
  LOST
  ABANDONED
}

/// A sales pipeline (Synamate "Pipelines"). Seeded default "Sales" pipeline mirrors LeadStage.
model Pipeline {
  id        String          @id @default(cuid())
  name      String
  position  Int             @default(0)
  isDefault Boolean         @default(false)
  deletedAt DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  stages    PipelineStage[]
  opps      Opportunity[]

  @@map("pipeline")
}

model PipelineStage {
  id          String        @id @default(cuid())
  pipelineId  String
  pipeline    Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  name        String
  position    Int
  // Bridge to the legacy enum: set on the seeded Sales pipeline so a board move write-throughs
  // to Lead.stage (keeping pipeline-metrics / funnel / reminders correct). Null on other pipelines.
  //
  // Known gap (docs/BUILD_CHECKLIST.md §7): this bridge is only populated for the one seeded
  // default pipeline today. A second pipeline's stage moves have no write-through to Lead.stage,
  // so anything reading Lead.stage can silently miss non-default-pipeline activity. Fixing that
  // is a Pipeline Unification Agent decision (extend the bridge everywhere, or make Lead.stage a
  // read-only projection computed from Opportunity) - deliberately not done here: it's a
  // cross-cutting behavior change, not an additive schema column, and touches every place that
  // reads or writes Lead.stage (funnel-metrics, WhatsApp reminders, pipeline dashboard, etc.).
  legacyStage LeadStage?
  // Default deal probability (0-100) for opportunities sitting in this stage, so "pipeline value"
  // can be shown as a weighted forecast rather than a flat sum. Nullable: existing/unset stages
  // fall back to flat-sum behavior until an admin sets one.
  probability Int?
  // Synamate's board ends in TWO won columns - "Split Pay" and "Full pay" - which in this schema
  // are one lifecycle stage (WON) plus a field (Lead.paymentPlan). This is the tiebreak: both
  // columns carry legacyStage WON, and this says which plan each one means. Set on the two
  // terminal columns of the seeded default pipeline, null everywhere else.
  //
  // It exists so the two directions can't disagree. Board → lead: dropping a card in "Split Pay"
  // writes SPLIT_PAY onto the lead. Lead → board: a lead that turns WON is filed into the column
  // matching its plan, instead of whichever WON column `findFirst` happened to return.
  paymentPlan PaymentPlan?
  deletedAt   DateTime?
  opps        Opportunity[]

  @@index([pipelineId, position])
  @@map("pipeline_stage")
}

/// A deal/opportunity on a board (Synamate "Opportunity"). Value stored dual-currency (paise +
/// cents) with the stamped FX rate, exactly like Income/Expense.
model Opportunity {
  id            String            @id @default(cuid())
  leadId        String
  lead          Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  pipelineId    String
  pipeline      Pipeline          @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stageId       String
  stage         PipelineStage     @relation(fields: [stageId], references: [id])
  name          String
  status        OpportunityStatus @default(OPEN)
  valueInrMinor BigInt            @default(0)
  valueEurMinor BigInt            @default(0)
  fxRateUsed    Decimal           @db.Decimal(14, 6)
  source        LeadSource?
  assignedToId  String?
  assignedTo    User?             @relation("OppOwner", fields: [assignedToId], references: [id], onDelete: SetNull)
  position      Int               @default(0) // order within its stage column on the board
  wonAt         DateTime?
  lostReason    String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  deletedAt     DateTime?
  deletedById   String?
  deletedBy     User?             @relation("OpportunityArchivedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  notes         ContactNote[]

  @@index([pipelineId, stageId, position])
  @@index([leadId])
  @@index([assignedToId, status])
  @@index([deletedAt])
  @@map("opportunity")
}

// ═══════════════ Synamate Sites parity - Phase 2 (SYNAMATE_CLONE_SPEC §Forms/Funnels) ═══════════════
// Native, self-hosted Forms + Funnels/landing pages. A public form/funnel submission funnels through
// the same idempotent lead-intake as the webhooks (source = NATIVE_FORM), so captures land straight
// in the CRM and (optionally) create an Opportunity. Retires the external FlexiFunnels dependency.

/// A reusable form (Synamate "Forms"). `fields` is FormField[]; `settings` is FormSettings JSON
/// (submit text, success message/redirect, tag, lead source, optional opportunity creation).
model Form {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  fields          Json // FormField[]  {key,label,type,required,placeholder?,options?}
  settings        Json // FormSettings
  published       Boolean          @default(false)
  submissionCount Int              @default(0)
  createdById     String?
  createdBy       User?            @relation("FormCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  submissions     FormSubmission[]

  @@map("form")
}

model FormSubmission {
  id        String   @id @default(cuid())
  formId    String
  form      Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  data      Json // raw answers keyed by field key
  utm       Json?
  createdAt DateTime @default(now())

  @@index([formId, createdAt])
  @@index([leadId])
  @@map("form_submission")
}

/// A funnel / multi-step landing site (Synamate "Funnels"/"Websites"). Public at /p/<slug>.
model Funnel {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  published   Boolean      @default(false)
  /// Block[] rendered above and below EVERY step of this funnel - the logo bar and the
  /// legal/footer strip. Held on the funnel rather than copied into each step because a funnel
  /// with four steps otherwise means changing the phone number in four places and missing one.
  /// Null (not `[]`) means "this funnel has none", so an empty header is a deliberate state.
  headerBlocks Json?
  footerBlocks Json?
  createdById String?
  createdBy   User?        @relation("FunnelCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  steps       FunnelStep[]

  @@map("funnel")
}

/// One page/step of a funnel. `blocks` is a Block[] JSON (heading/text/image/button/form/video/…).
model FunnelStep {
  id             String  @id @default(cuid())
  funnelId       String
  funnel         Funnel  @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  name           String
  slug           String
  position       Int
  blocks         Json // Block[]
  seoTitle       String?
  seoDescription String?
  views          Int     @default(0)

  /// ── A/B split ──────────────────────────────────────────────────────────────────────────────
  /// A variant points at the step it is testing against; that step (the control) has this null.
  /// Modelled as ordinary steps rather than a separate table so a variant IS a page - it gets the
  /// same builder, the same renderer and the same `views` counter, and nothing has to learn a
  /// second shape. A variant is hidden from the funnel's own navigation: it is reachable only by
  /// being chosen for a visitor.
  abTestOf   String?
  abControl  FunnelStep?  @relation("AbVariants", fields: [abTestOf], references: [id], onDelete: Cascade)
  abVariants FunnelStep[] @relation("AbVariants")
  /// Relative share of traffic, against the control's own weight. Not a percentage: percentages
  /// have to sum to 100 and silently break when a third variant is added.
  abWeight   Int          @default(50)

  @@unique([funnelId, slug])
  @@index([funnelId, position])
  @@index([abTestOf])
  @@map("funnel_step")
}

/// A saved chunk of page - one section, a testimonial card, a whole CTA band - kept for reuse.
///
/// Both halves of "templates" and "section library" are this one model: a TEMPLATE is a snippet
/// holding an entire page (`scope: PAGE`), a library SECTION is one holding a fragment. Two
/// tables would have meant two editors, two pickers and two ways to drift.
model SectionSnippet {
  id          String   @id @default(cuid())
  name        String
  /// Grouping for the picker ("Hero", "Social proof", "Closing") - free text, not an enum, so
  /// the team can organise their own library without a migration.
  category    String?
  scope       SnippetScope @default(SECTION)
  /// Block[] - the nodes to insert. Ids are regenerated on insert, so one snippet used twice on
  /// a page cannot produce duplicate node ids.
  blocks      Json
  /// Seeded starter content is BUILT-IN and cannot be deleted from the UI; anything the team
  /// saves is theirs to remove.
  builtIn     Boolean  @default(false)
  createdById String?
  createdBy   User?    @relation("SnippetCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([scope, category])
  @@map("section_snippet")
}

enum SnippetScope {
  /// A fragment - inserted into the page you are editing.
  SECTION
  /// A whole page - offered when creating a new step.
  PAGE
}

// ═══════════════ Sites - the marketing website (replaces the GHL-hosted b2consultants.de) ═══════
// A WEBSITE is not a funnel, and this is deliberately not built on Funnel/FunnelStep.
//
// A funnel is an ORDERED sequence: step 1 → 2 → 3, and `position` is the whole navigation model.
// A website is a SET of pages reached from a shared nav in any order. Modelling b2consultants.de
// as funnel steps would mean hand-maintaining the nav on every page and renumbering to insert one
// - so `Funnel`/`FunnelStep` above stays exactly as it is, for the thing it is actually good at:
// the opt-in flow. optin.b2consultants.de remains on GHL and is NOT modelled here at all; the new
// pages link OUT to it, forwarding their query string so attribution survives the hostname hop.

/// One hosted website = one domain. Theme, nav and the shared header/footer live here, so a page
/// created next year inherits them without anyone copying anything.
model Site {
  id   String @id @default(cuid())
  name String
  /// URL path prefix while the real domain is still pointed at GHL: /s/<slug>/…
  slug String @unique
  /// Primary hostname, once DNS is cut over. NULL means "not serving a domain yet", which is the
  /// state this ships in - the rebuild is verified on b2app.sirahagents.com first.
  domain String? @unique

  /// Design tokens (colours, fonts, radii) as SiteTheme JSON. Held per-site rather than read from
  /// the dashboard's own Tailwind tokens because this site must NOT inherit the app's look - it
  /// has its own brand, and the two must be free to diverge.
  theme Json
  /// NavItem[] - the shared header menu. External targets (the GHL opt-in) are just absolute hrefs.
  navMenu Json

  faviconUrl String?
  /// Tracking. Absent = not injected at all, rather than an empty script tag.
  metaPixelId     String?
  gaMeasurementId String?

  published   Boolean  @default(false)
  createdById String?
  createdBy   User?    @relation("SiteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pages    SitePage[]
  sections SiteSection[]

  @@map("site")
}

/// A shared, reusable band - the header and footer that appear on every page.
/// Stored once and referenced, so editing the footer does not mean editing five pages.
enum SiteSectionKind {
  HEADER
  FOOTER
  REUSABLE
}

model SiteSection {
  id     String          @id @default(cuid())
  siteId String
  site   Site            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  kind   SiteSectionKind
  name   String
  /// Section[] JSON - same shape as SitePage.sections.
  blocks Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId, kind])
  @@map("site_section")
}

/// One page. `path` is the public path within the site ("/", "/aboutus"), NOT a slug fragment -
/// the live URLs are being reproduced exactly, and "/aboutus" is not what slugify() would produce.
model SitePage {
  id     String @id @default(cuid())
  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  path   String
  title  String

  /// Section[] - the page body. A JSON blob rather than section rows, matching FunnelStep.blocks:
  /// the editor saves a whole page at once and revisions snapshot it, so rows would buy nothing
  /// and cost a join on every public render.
  sections Json

  seoTitle       String?
  seoDescription String?
  ogImageUrl     String?
  /// Excluded from the generated sitemap/robots (privacy and terms do not need indexing).
  noIndex Boolean @default(false)

  published Boolean   @default(false)
  /// Denormalised view counter. Incremented in batches, NOT per request - see the public route.
  views     Int       @default(0)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  revisions SitePageRevision[]

  @@unique([siteId, path])
  @@index([siteId, published])
  @@map("site_page")
}

/// An immutable snapshot taken on every save, so "restore what it looked like on Tuesday" is a
/// row lookup. GHL shows a version history and the team will expect one; more to the point, this
/// site takes paid traffic and a bad edit needs a one-click way back.
model SitePageRevision {
  id     String   @id @default(cuid())
  pageId String
  page   SitePage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  /// The full `sections` blob as it was after this save.
  sections Json
  /// Optional human label ("before pricing change"); autosaves leave it null.
  label       String?
  createdById String?
  createdBy   User?    @relation("SitePageRevisionBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([pageId, createdAt])
  @@map("site_page_revision")
}

/// An uploaded image in the media library, stored in Supabase Storage (same project as the DB).
/// The row is the INDEX - `storageKey` is the object path, `url` the public URL. Bytes never live
/// in Postgres: the existing data-URL-in-a-column trick is fine for a 64px avatar and wrong for a
/// hero image, which must be CDN-cacheable and resizable by next/image.
model MediaAsset {
  id         String @id @default(cuid())
  storageKey String @unique
  url        String
  filename   String
  mimeType   String
  bytes      Int
  /// Intrinsic dimensions, captured at upload so the renderer can set width/height and avoid
  /// layout shift without measuring the image at request time.
  width  Int?
  height Int?
  /// Editable alt text - the media library is the right place to fix accessibility once, rather
  /// than re-typing alt on every page that uses the image.
  alt String?

  uploadedById String?
  uploadedBy   User?     @relation("MediaUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  @@index([deletedAt, createdAt])
  @@map("media_asset")
}

// ═══════════════ Synamate Payments parity - Phase 3 (invoicing, no processor yet) ═══════════════
// Invoices + estimates (kind), reusable Products, manual Payments (Transactions), and Subscriptions.
// Money is dual INR (paise, primary) + EUR (cents) with a stamped fxRate, like Income/Expense. No
// payment processor is wired yet - status is advanced manually; `publicToken` powers /i/<token>.
// A `provider` + `externalId` seam is left on payments so Razorpay/Stripe can drop in later.

enum ProductInterval {
  ONE_TIME
  MONTHLY
  QUARTERLY
  YEARLY
}

model Product {
  id            String          @id @default(cuid())
  name          String
  description   String?
  priceInrMinor BigInt          @default(0)
  priceEurMinor BigInt          @default(0)
  fxRateUsed    Decimal?        @db.Decimal(14, 6) // INR per 1 EUR when the EUR price was last set
  interval      ProductInterval @default(ONE_TIME)
  active        Boolean         @default(true)
  deletedAt     DateTime?
  deletedById   String?
  deletedBy     User?           @relation("ProductArchivedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  subscriptions Subscription[]

  @@index([deletedAt])
  @@map("product")
}

enum InvoiceKind {
  INVOICE
  ESTIMATE
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  PARTIAL
  OVERDUE
  VOID
  ACCEPTED // estimates
  DECLINED // estimates
}

model Invoice {
  id               String            @id @default(cuid())
  kind             InvoiceKind       @default(INVOICE)
  number           String            @unique // INV-0001 / EST-0001
  status           InvoiceStatus     @default(DRAFT)
  leadId           String?
  lead             Lead?             @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customerName     String
  customerEmail    String?
  customerPhone    String?
  issueDate        DateTime          @db.Date
  dueDate          DateTime?         @db.Date
  subtotalInrMinor BigInt            @default(0)
  discountInrMinor BigInt            @default(0)
  taxPercent       Decimal           @default(0) @db.Decimal(6, 3)
  taxInrMinor      BigInt            @default(0)
  totalInrMinor    BigInt            @default(0)
  totalEurMinor    BigInt            @default(0)
  fxRateUsed       Decimal           @db.Decimal(14, 6)
  notes            String?
  publicToken      String            @unique @default(cuid())
  sentAt           DateTime?
  paidAt           DateTime?
  createdById      String?
  createdBy        User?             @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  deletedById      String?
  deletedBy        User?             @relation("InvoiceArchivedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  items            InvoiceLineItem[]
  payments         InvoicePayment[]

  @@index([status])
  @@index([kind, createdAt])
  @@index([leadId])
  @@index([deletedAt])
  @@map("invoice")
}

model InvoiceLineItem {
  id                String  @id @default(cuid())
  invoiceId         String
  invoice           Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description       String
  quantity          Int     @default(1)
  unitPriceInrMinor BigInt  @default(0)
  position          Int     @default(0)

  @@index([invoiceId])
  @@map("invoice_line_item")
}

model InvoicePayment {
  id             String   @id @default(cuid())
  invoiceId      String
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amountInrMinor BigInt
  method         String // cash / upi / bank / razorpay / stripe (free text until a processor is wired)
  reference      String?
  provider       String? // future: "razorpay" | "stripe"
  externalId     String? // future: processor payment id
  paidAt         DateTime @default(now())
  recordedById   String?
  recordedBy     User?    @relation("InvoicePaymentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([recordedById])
  @@map("invoice_payment")
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

model Subscription {
  id              String             @id @default(cuid())
  leadId          String?
  lead            Lead?              @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customerName    String
  productId       String?
  product         Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)
  amountInrMinor  BigInt             @default(0)
  amountEurMinor  BigInt             @default(0)
  fxRateUsed      Decimal?           @db.Decimal(14, 6) // INR per 1 EUR when the EUR amount was last set
  interval        ProductInterval    @default(MONTHLY)
  status          SubscriptionStatus @default(ACTIVE)
  nextBillingDate DateTime?          @db.Date
  startedAt       DateTime           @default(now())
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([status])
  @@index([leadId])
  @@map("subscription")
}

// ═══════════════ Synamate Conversations parity - Phase 4 (Email + SMS + templates) ═══════════════
// Adds Email + SMS channels beside the existing WhatsApp/WATI log, reusable message templates, and
// a unified inbox (read-time merge of Message + WhatsAppMessage per contact). Providers (Resend for
// email, Twilio for SMS) are fetch-based and OFF by default - with keys unset a send writes a
// SKIPPED row and nothing leaves the app, exactly like the WATI seam.

enum MessageChannel {
  EMAIL
  SMS
}

enum MessageDirection {
  OUTBOUND
  INBOUND
}

enum MessageStatus {
  SKIPPED // provider off / opted out - logged, not sent
  QUEUED
  SENT
  DELIVERED
  FAILED
}

model Message {
  id           String           @id @default(cuid())
  channel      MessageChannel
  direction    MessageDirection @default(OUTBOUND)
  status       MessageStatus    @default(QUEUED)
  leadId       String?
  lead         Lead?            @relation(fields: [leadId], references: [id], onDelete: SetNull)
  toAddress    String // email address or phone number
  fromAddress  String?
  subject      String? // email only
  body         String
  provider     String? // "resend" | "twilio"
  externalId   String?
  error        String?
  sentById     String?
  sentBy       User?            @relation("MessageSentBy", fields: [sentById], references: [id], onDelete: SetNull)
  // Conversations inbox read-state + assignment (docs/BUILD_CHECKLIST.md §8). Inbound messages
  // default unread; outbound ones are meaningless to mark unread but the field stays uniform.
  read         Boolean          @default(false)
  assignedToId String?
  assignedTo   User?            @relation("MessageAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdAt    DateTime         @default(now())

  @@index([leadId, createdAt])
  @@index([channel, createdAt])
  @@index([direction, read])
  @@index([assignedToId])
  @@map("message")
}

model MessageTemplate {
  id        String         @id @default(cuid())
  channel   MessageChannel
  name      String
  subject   String? // email only
  body      String // supports {{name}} / {{first_name}} tokens
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@map("message_template")
}

// ═══════════════ Synamate Automation parity - Phase 5 (workflow engine) ═══════════════
// A trigger (form submit / tag added / stage change / contact created / invoice paid / booking)
// enrolls a contact, then runs a linear list of actions (send email/SMS, add/remove tag, move stage,
// create task, wait). WAIT actions pause the enrollment; a cron (/api/cron/workflows, CRON_SECRET)
// resumes due ones - the SAME external-cron seam the WhatsApp reminders use. Loop-guarded: an active
// enrollment is never re-created for the same (workflow, contact), and actions never re-emit triggers.

enum WorkflowStatus {
  DRAFT
  PUBLISHED
}

enum TriggerType {
  FORM_SUBMITTED
  TAG_ADDED
  STAGE_CHANGED
  CONTACT_CREATED
  INVOICE_PAID
  BOOKING_CREATED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  FAILED
}

/// Synamate parity: workflows are grouped into folders ("Calendar Booking Automations",
/// "Pipeline Automations", …). Flat (no nesting) - the reference only ever shows one level.
model WorkflowFolder {
  id        String     @id @default(cuid())
  name      String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  workflows Workflow[]

  @@map("workflow_folder")
}

model Workflow {
  id            String               @id @default(cuid())
  name          String
  status        WorkflowStatus       @default(DRAFT)
  triggerType   TriggerType
  triggerConfig Json? // { formId? | tag? | stage? }
  actions       Json // WorkflowAction[]
  totalEnrolled Int                  @default(0)
  /// null = the root ("Home") folder in the UI. SetNull so deleting a folder never
  /// takes its workflows with it - they fall back to root.
  folderId      String?
  folder        WorkflowFolder?      @relation(fields: [folderId], references: [id], onDelete: SetNull)
  /// Soft delete: set = in the "Deleted" tab, excluded from every live read and from
  /// emitTrigger's enrollment scan. Restorable. Hard delete is admin-only + explicit.
  deletedAt     DateTime?
  createdById   String?
  createdBy     User?                @relation("WorkflowCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  enrollments   WorkflowEnrollment[]

  // emitTrigger filters on (status, triggerType, deletedAt) - keep all three together.
  @@index([status, triggerType, deletedAt])
  @@index([folderId])
  @@index([deletedAt])
  @@map("workflow")
}

model WorkflowEnrollment {
  id          String           @id @default(cuid())
  workflowId  String
  workflow    Workflow         @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  leadId      String
  lead        Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  status      EnrollmentStatus @default(ACTIVE)
  currentStep Int              @default(0)
  nextRunAt   DateTime? // null = ready now; set to a future time by a WAIT action
  context     Json?
  lastError   String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([status, nextRunAt])
  @@index([workflowId, leadId])
  @@map("workflow_enrollment")
}

// ─────────────────── Wave-1 - Booking + Lead capture (Synamate in-sourcing) ───────────────────
// Replaces Synamate's two functions in-house: (1) a public qualification booking page that
// scores BANT and books a slot, (2) a lead inbox fed by our own webhooks (Meta / FlexiFunnels)
// plus manual entry. No automated messaging here - that is Wave-2, gated on Ameen's sign-off.

enum SlotStatus {
  OPEN
  BOOKED
  BLOCKED
}

/// WHICH stage produced a lead's band score (Application Logic §4.3's two-stage scoring).
///
/// Recorded rather than inferred because the three carry different authority. OPT_IN is the
/// landing page's own answers - the earliest and least verified. BOOKING is the fuller intake
/// form and supersedes it. MANUAL is a human's judgement and supersedes BOTH: a redelivered
/// webhook must never overwrite what a specialist typed after speaking to the person.
enum BantSource {
  OPT_IN // landing page / relayed opt-in form (Pabbly, FlexiFunnels, Meta)
  BOOKING // the /book qualification form
  MANUAL // set by a specialist in the back office
}

// Weighted-BANT recommendation (avg of the four 0–5 dimension scores).
enum BantVerdict {
  CONFIRM // avg > 3 - confirm the call
  DOUBT // avg 2–3 - go ahead, but doubt they'll convert
  CANCEL // avg < 2 - cancel / don't book the call
}

enum BookingStatus {
  BOOKED
  RESCHEDULED
  CANCELLED
  COMPLETED
  NO_SHOW
}

// Bookable discovery-call slots (replaces Synamate's calendar). Admin generates availability;
// the public booking page shows OPEN future slots. startsAt is a UTC instant, shown in IST + CET.
model AppointmentSlot {
  id           String          @id @default(cuid())
  startsAt     DateTime // UTC instant
  durationMins Int             @default(30)
  status       SlotStatus      @default(OPEN)
  assignedToId String?
  assignedTo   User?           @relation("SlotAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  booking      BookingRequest?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([status, startsAt])
  @@map("appointment_slot")
}

/// SSS (Success Strategy Session) slot - the founder-run sales/closing call calendar. Distinct
/// from AppointmentSlot (the public discovery booking): an SSS slot is booked by linking an
/// existing OutreachJourney, not a fresh BANT intake. Reuses SlotStatus (OPEN/BOOKED/BLOCKED).
///
/// Block/unblock and auto-reschedule (server/sss-slots.ts) mirror the discovery
/// booking-automation engine: blocking a BOOKED slot moves its journey to the next OPEN slot for
/// the same owner and resets the SSS confirmation. journey.sssAt is kept in sync with startsAt.
model SssSlot {
  id           String     @id @default(cuid())
  startsAt     DateTime // UTC instant
  durationMins Int        @default(45)
  status       SlotStatus @default(OPEN)
  // Who runs this SSS (defaults to the configured SSS owner). Per-slot so a reschedule keeps the
  // same closer and blocking one owner's day leaves another owner's slots untouched.
  ownerId      String?
  owner        User?      @relation("SssSlotOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  // The prospect's journey booked into this slot (null unless BOOKED). One journey → at most one
  // SSS slot.
  journeyId    String?          @unique
  journey      OutreachJourney? @relation("SssSlotJourney", fields: [journeyId], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([status, startsAt])
  @@index([ownerId, startsAt])
  @@map("sss_slot")
}

// Public qualification intake (parity with Synamate's "Appointment booking" export).
// BANT is computed from the answers at submit time (src/lib/bant.ts) and mirrored to the
// linked Lead so the pipeline's "Call these first" scoring can reuse it.
model BookingRequest {
  id     String           @id @default(cuid())
  slotId String?          @unique
  slot   AppointmentSlot? @relation(fields: [slotId], references: [id], onDelete: SetNull)
  leadId String?
  lead   Lead?            @relation(fields: [leadId], references: [id], onDelete: SetNull)

  // Contact
  name     String
  email    String
  phone    String
  whatsapp String?
  city     String?

  // Qualification answers (free-text / select values, stored verbatim as Synamate did)
  currentJobTitle        String?
  prospectIndustry       String?
  linkedInProfile        String?
  highestEducation       String?
  yearsExperience        String?
  whyGermany             String?
  participateWorkshop    Boolean @default(false)
  reasonForCall          String?
  alreadyApplied         String?
  whenStartGermany       String?
  germanVisa             String?
  germanLevel            String?
  willingnessLearnGerman String?
  currentIncome          String?
  readyToInvest          String?
  decisionMaking         String?
  commitment             String?
  howKnowUs              String?

  // BANT - derived on submit; bantScore is 0–4 (count of the four dimensions met).
  // Weighted layer (client notes): every answer carries a 0–5 score; bantAvg is the
  // mean of the four dimension scores and bantVerdict applies Ameen's thresholds
  // (>3 confirm · 2–3 doubt · <2 cancel). Recommendation only - no automated action.
  bantBudget    Boolean      @default(false)
  bantAuthority Boolean      @default(false)
  bantNeed      Boolean      @default(false)
  bantTimeline  Boolean      @default(false)
  bantScore     Int          @default(0)
  bantAvg       Float?
  bantVerdict   BantVerdict?
  /// Track D cutover instrumentation. `bantShadowAvg` is what the CONFIGURABLE question
  /// catalogue would have scored this submission - written alongside the column-based score
  /// during the shadow phase and compared, never read by any decision. A disagreement is a
  /// seeding bug, and the flip to the catalogue is gated on there being none.
  /// `bantConfigVersion` records which catalogue produced a verdict once the flip happens,
  /// so a re-tune can never be mistaken for what THIS prospect was judged on.
  bantShadowAvg     Float?
  bantConfigVersion Int?

  // Confirmation loop (Module E). A booked call must be confirmed before it happens; if the
  // prospect never confirms, the auto-cancel engine (booking-automation.ts) releases the slot and
  // promotes the next same-caller/same-day call into it. `confirmSentAt` records when the
  // confirm-request went out (so the engine asks once, then cancels if unanswered); `confirmedAt`
  // is set by a WhatsApp "yes" (wati/webhook) or a manual "Mark confirmed" from the Bookings table.
  confirmSentAt DateTime?
  confirmedAt   DateTime?

  status      BookingStatus @default(BOOKED)
  source      Source        @default(BOOKING_FORM)
  utm         Json?
  externalRef String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  whatsappMessages WhatsAppMessage[]
  outreachJourney  OutreachJourney?
  answers          LeadAnswer[]

  @@index([status, createdAt])
  @@index([bantScore])
  // Step 10 (booking cross-check) matches a lead to a booking by email. Postgres can only use
  // an index for that if the query's lower(email) matches an expression index of the same shape.
  @@index([email])
  @@map("booking_request")
}

// ───────────────────────────── Phase 2 - People ─────────────────────────────

enum TeamStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
}

// Which daily-log form a person gets (PRD2 §3.3) - by function, not hardcoded name.
enum DailyLogVariant {
  DISCOVERY_SPECIALIST // Asma: calls completed, HQ calls, follow-ups, proposals, no-shows
  APPOINTMENT_SETTER // Nilofer: leads contacted, appointments set, follow-ups, pipeline adds
  DELIVERY_COACH // Karthick: sessions, check-ins, assignments, at-risk flags
}

// Who wrote a DailyLog row. The Telecaller Pay board sums these numbers into the calls a
// bonus/commission is judged on, so "a person said this" and "the EOD job derived this from
// activity" must never look the same.
//
// HUMAN    - submitted by the member. One-shot and immutable (PRD2 §3.3).
// EOD_AUTO - the member never logged, so the EOD job wrote what activity it could derive.
//            Auto-capture cannot see every field (followUpMessagesSent has no event source),
//            so these rows are INCOMPLETE by construction and read low on the pay board.
//            That is why, unlike a HUMAN row, they stay amendable by their owner for a
//            short window - the member fills in the rest and the row flips to HUMAN.
enum DailyLogSource {
  HUMAN
  EOD_AUTO
}

model TeamProfile {
  id                  String          @id @default(cuid())
  userId              String?         @unique
  user                User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  fullName            String
  roleTitle           String // e.g. Discovery Call Specialist
  dashboardRole       Role            @default(USER)
  email               String
  phone               String?
  dateJoined          DateTime?       @db.Date
  keyResponsibilities String?
  status              TeamStatus      @default(ACTIVE)
  logVariant          DailyLogVariant
  orderIndex          Int             @default(0) // org-chart card order (Admin can rearrange)
  // First-call assignment rules (client notes): target share of incoming leads
  // (Nilofer 80 / Asma 20) and Saturday availability (Asma doesn't work Saturdays).
  // Drives the intake auto-assign suggestion; manual reassignment always overrides.
  firstCallSharePct   Int             @default(0) // 0 = not in the first-call rotation
  worksSaturdays      Boolean         @default(true)
  // How many calls this person is expected to make on a working day. Admin-set (dynamic),
  // 0 = no target, which hides the target UI rather than showing "0 / 0".
  // Deliberately NOT a Goal: GoalPeriod has no DAY, and a daily bar is a working-day
  // notion (Saturdays follow worksSaturdays) that the monthly Goal engine doesn't model.
  dailyCallTarget     Int             @default(0)

  /// ── TERMINATION ───────────────────────────────────────────────────────────────────
  /// Set when someone leaves. `status` goes INACTIVE and the linked `User` is SUSPENDED in the
  /// same transaction - the two statuses were previously never kept in sync by any code path,
  /// and different modules filter on different ones.
  ///
  /// DELIBERATELY NOT the `deletedAt` soft-delete pattern used by the nine core record types.
  /// Archived records are purged by the 90-day retention cron (`server/retention.ts`), and a
  /// person's employment record must never be purged - their name has to keep resolving on every
  /// call, commission and audit row they ever produced. "Former team member" is a permanent,
  /// restorable state, not a staging area for deletion.
  terminatedAt       DateTime?
  terminatedById     String?
  terminatedBy       User?     @relation("TeamProfileTerminatedBy", fields: [terminatedById], references: [id], onDelete: SetNull)
  terminationReason  String?
  /// Who picked up their open work. Recorded so "why does Asma own this lead" stays answerable
  /// years later - the reassignment itself leaves no trace on the row it moved.
  successorProfileId String?

  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  okrs              OKR[]
  telecallerPayouts TelecallerPayout[]
  goals             Goal[]
  rewardGrants      RewardGrant[]

  // Declared here to match what 20260803090000_team_profile_termination actually created. The
  // migration made this index; the model never mentioned it, so Prisma believed it was unwanted
  // and every `migrate diff` since has wanted to DROP it - which would have silently removed a
  // live index the moment anyone generated the next migration.
  @@index([terminatedAt])
  @@map("team_profile")
}

// Max 3 per person per month - enforced at the service layer (PRD2 §3.2).
model OKR {
  id                  String      @id @default(cuid())
  teamProfileId       String
  teamProfile         TeamProfile @relation(fields: [teamProfileId], references: [id], onDelete: Cascade)
  month               DateTime    @db.Date // first day of month
  title               String
  targetValue         String // "80%", "50 calls" - free text per PRD
  targetNumeric       Decimal?    @db.Decimal(14, 2) // parsed when numeric → auto completion %
  currentProgress     String?
  currentNumeric      Decimal?    @db.Decimal(14, 2)
  manualCompletionPct Int? // Admin sets when target is text (PRD2 §3.2)
  notes               String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([teamProfileId, month])
  @@map("okr")
}

// APPEND-ONLY (PRD2 §6): one per user per day; corrections are notes, never edits.
model DailyLog {
  id      String          @id @default(cuid())
  userId  String
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  date    DateTime        @db.Date
  variant DailyLogVariant

  // DISCOVERY_SPECIALIST
  discoveryCallsCompleted Int?
  highlyQualifiedCalls    Int?
  followUpsDone           Int?
  proposalsSent           Int?
  noShows                 Int?

  // APPOINTMENT_SETTER
  newLeadsContacted    Int?
  appointmentsSet      Int?
  followUpMessagesSent Int?
  leadsAddedToPipeline Int?

  // DELIVERY_COACH
  sessionsDelivered     Int?
  studentsCheckedInOn   Int?
  assignmentsReviewed   Int?
  studentsFlaggedAtRisk Int?

  // HUMAN unless the EOD job wrote it. Defaulted, so every pre-existing row is correctly
  // HUMAN - before this field existed, a row could only come from the submit form.
  source DailyLogSource @default(HUMAN)

  notes          String? // notes / blockers
  correctionNote String? // Admin may append a correction - original stays intact
  // Which numeric fields were auto-filled from real activity at submit time (report §3.A).
  // A JSON array of field keys - lets the timeline badge historical entries as auto-captured,
  // not just today's (today's is recomputed live; history needs this record).
  autoCapturedKeys Json?
  createdAt        DateTime @default(now())

  @@unique([userId, date]) // one log per person per day (PRD2 §3.3)
  @@index([date])
  @@map("daily_log")
}

// Whether an assigned reward has actually been paid out yet.
enum PayoutStatus {
  PENDING
  PAID
}

// Telecaller rewards: Admin (Ameen) assigns a BONUS and/or COMMISSION to a
// telecaller (a USER-role TeamProfile - appointment setters / discovery specialists)
// for a given month, with a free-text reason ("based on the calls or any other
// criteria"). Amounts are entered manually. Dual-currency like all money in the
// app: INR + EUR minor units, FX stamped at entry so history never re-prices.
model TelecallerPayout {
  id            String       @id @default(cuid())
  teamProfileId String
  teamProfile   TeamProfile  @relation(fields: [teamProfileId], references: [id], onDelete: Cascade)
  month         DateTime     @db.Date // first day of the month this reward is for
  bonusInrMinor BigInt       @default(0) // paise
  bonusEurMinor BigInt       @default(0) // cents
  commInrMinor  BigInt       @default(0) // commission, paise
  commEurMinor  BigInt       @default(0) // commission, cents
  fxRateUsed    Decimal      @db.Decimal(14, 6) // INR per 1 EUR at entry
  reason        String // the criteria: calls hit, targets, QA, spot bonus…
  status        PayoutStatus @default(PENDING)
  enteredById   String?
  enteredBy     User?        @relation("TelecallerPayoutEnteredBy", fields: [enteredById], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([teamProfileId, month])
  @@index([month])
  @@map("telecaller_payout")
}

// ───────────────────────────── Phase 2 - Students ─────────────────────────────

enum StudentStatus {
  ACTIVE
  COMPLETED
  DROPPED
  PAUSED
}

enum ProgramDuration {
  DAYS_90 // Guided
  DAYS_120 // Elite
  LIFETIME // Solo - no end date, no tracker
}

enum Milestone {
  ONBOARDING
  RESUME_BUILD
  LINKEDIN_OPTIMISATION
  APPLICATIONS
  INTERVIEWS
  OFFER_RECEIVED
  COMPLETED
}

enum TaskCompletion {
  YES
  NO
  PENDING
}

// ONE person = ONE Student record; upgrades create additional Enrollments (CONTEXT §7).
// LTV = sum of linked Income across all enrollments - computed, never stored.
model Student {
  id            String      @id @default(cuid())
  /// Human-readable student number shown beside the name EVERYWHERE (§6.1). Two students
  /// called "Anna Smith" are indistinguishable on screen without it - that ambiguity has
  /// already caused a real payment mix-up. The cuid `id` can't do this job: nobody can read
  /// one aloud on a call. Nullable because it is backfilled, and unique so the generator can
  /// rely on the database to reject a collision rather than a read-then-write race.
  code          String?     @unique
  fullName      String
  email         String?
  phone         String?
  /// Intake field 4 of 4 (spec Part 2 §1: name / email / phone / address). Also the ship-to
  /// the book vendor couriers against, so BookOrder snapshots it rather than reading it live.
  address       String?
  industry      String?
  targetRole    String? // target country role in Germany
  leadSource    LeadSource? // GHOSTED_BLUEPRINT here drives Phase 3 attribution
  leadId        String?
  lead          Lead?       @relation(fields: [leadId], references: [id], onDelete: SetNull)
  // Optional portal login (Role.STUDENT). One student ↔ one user; deleting the
  // user account never touches the student record.
  userId        String?     @unique
  user          User?       @relation("StudentAccount", fields: [userId], references: [id], onDelete: SetNull)
  internalNotes String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  enrollments        Enrollment[]
  incomes            Income[]
  pendingPayments    PendingPayment[]
  satisfactionScores SatisfactionScore[]
  gnMemberships      BatchMember[]
  pendingJoins       GnPendingJoiner[]
  bookOrders         BookOrder[]
  whatsappMessages   WhatsAppMessage[]
  agreements         Agreement[]
  taskCompletions    SessionTaskCompletion[]
  attendance         SessionAttendance[]
  resumes            Resume[]

  @@index([fullName])
  @@map("student")
}

model Enrollment {
  id              String          @id @default(cuid())
  studentId       String
  student         Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  /// ER v2 `LEAD ||--o| ENROLLMENT`. Direct, rather than only via Student.leadId - a student
  /// who came back through a second campaign has two acquisition stories, and attribution
  /// needs the one for THIS sale.
  leadId          String?
  lead            Lead?           @relation("EnrollmentLead", fields: [leadId], references: [id], onDelete: SetNull)
  /// ER v2 `ENROLLMENT }o--|| BATCH` (Track A). Nullable and expected to stay that way for
  /// coaching if D2 comes back "1:1" - the column costs nothing in that case, and German
  /// Note seats populate it immediately.
  batchId         String?
  batch           Batch?          @relation(fields: [batchId], references: [id], onDelete: SetNull)
  programLevel    String // Level.code - SOLO / GUIDED / ELITE only for B2 (service-validated)
  enrollmentDate  DateTime        @db.Date
  duration        ProgramDuration
  programEndDate  DateTime?       @db.Date // enrollment + 90/120 days; null for LIFETIME
  assignedCoach   String? // currently Karthick
  // L3 closer who ran the sales/SSS call - the third leg of the commission split
  // (setter + discovery are inferred from the Lead; the closer had no home before).
  closerId        String?
  closer          User?           @relation("EnrollmentCloser", fields: [closerId], references: [id], onDelete: SetNull)
  status          StudentStatus   @default(ACTIVE)
  statusChangedAt DateTime        @default(now()) // powers "completed/dropped this month"

  // 90/120-day tracker (PRD2 §4.3) - Guided/Elite only
  lastSessionDate        DateTime?       @db.Date
  totalSessionsCompleted Int             @default(0)
  totalSessionsPlanned   Int?
  lastTaskAssigned       String?
  lastTaskCompleted      TaskCompletion?
  applicationsSubmitted  Int             @default(0)
  interviewsReceived     Int             @default(0)
  currentMilestone       Milestone       @default(ONBOARDING)
  signalColour           Signal? // manual G/A/R, set by Admin/Head
  signalNotes            String?
  nextCheckInDate        DateTime?       @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  incomes         Income[]
  milestoneLogs   MilestoneLog[]
  signalChanges   SignalChangeLog[]
  sprintWeeks     SprintWeek[]
  jobApplications JobApplication[]
  milestoneProgress MilestoneProgress[]
  agreements      Agreement[]
  bookOrders      BookOrder[]
  pendingPayments PendingPayment[]

  @@index([studentId])
  @@index([status, programLevel])
  @@index([signalColour])
  @@index([closerId])
  @@index([batchId])
  @@index([leadId])
  @@map("enrollment")
}

// ── Per-application placement tracking (spec Module I) ──────────────
// Richer than the aggregate counts on Enrollment (applicationsSubmitted /
// interviewsReceived), which stay as the tracker's headline numbers. One row per
// real application, moving applied → interview → selected/rejected.
enum JobApplicationStatus {
  APPLIED
  INTERVIEW
  SELECTED
  REJECTED
}

model JobApplication {
  id           String               @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment           @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  /// ER v2 `JOB_APPLICATION.cv_id / jd_id` (Track H). Both SetNull and both optional: the
  /// company/role/jobUrl strings above stay as the record of what was applied to, so an
  /// application whose JD was later retired still reads correctly.
  resumeId         String?
  jobDescriptionId String?
  jobDescription   JobDescription? @relation(fields: [jobDescriptionId], references: [id], onDelete: SetNull)
  company      String
  role         String
  jobUrl       String?
  location     String?
  status       JobApplicationStatus @default(APPLIED)
  appliedAt    DateTime             @db.Date
  statusAt     DateTime             @default(now()) // when it last changed status
  notes        String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([enrollmentId, status])
  @@index([status, statusAt])
  @@index([jobDescriptionId])
  @@map("job_application")
}

// ── Sprint tracker (client notes): week-wise targets after course completion ──
// Guided = 90 days (13 weeks) · Elite = 120 days (17 weeks). Coach sets the target,
// the weekend check-in records the actual; ACHIEVED = "no disturbance", MISSED feeds
// the at-risk radar. The WhatsApp nudge on a miss is Wave-2 (gated) - here it's data.

enum SprintStatus {
  PENDING // week not reviewed yet
  ACHIEVED // target met - no disturbance
  MISSED // target missed - ask why / take action
}

model SprintWeek {
  id            String       @id @default(cuid())
  enrollmentId  String
  enrollment    Enrollment   @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  weekIndex     Int // 1-based
  weekStart     DateTime     @db.Date
  weekEnd       DateTime     @db.Date // inclusive last day (the check-in weekend)
  target        String? // e.g. "15 applications, 2 networking calls"
  targetNumeric Decimal?     @db.Decimal(14, 2) // parsed when numeric → auto achieved/missed
  actual        String? // what actually happened (student check-in or coach entry)
  actualNumeric Decimal?     @db.Decimal(14, 2)
  status        SprintStatus @default(PENDING)
  note          String? // why missed / coach comment
  enteredById   String?
  enteredBy     User?        @relation("SprintEnteredBy", fields: [enteredById], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([enrollmentId, weekIndex])
  @@index([status, weekEnd])
  @@map("sprint_week")
}

// APPEND-ONLY milestone history (PRD2 §4.4) - cannot be deleted by anyone, incl. Admin.
model MilestoneLog {
  id                String     @id @default(cuid())
  enrollmentId      String
  enrollment        Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  date              DateTime   @default(now())
  updatedById       String?
  updatedBy         User?      @relation("MilestoneUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  previousMilestone Milestone?
  newMilestone      Milestone
  note              String?

  @@index([enrollmentId])
  @@map("milestone_log")
}

// APPEND-ONLY signal-colour audit (PRD2 §6: every change logged with date + user).
model SignalChangeLog {
  id             String     @id @default(cuid())
  enrollmentId   String
  enrollment     Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  date           DateTime   @default(now())
  changedById    String?
  changedBy      User?      @relation("SignalChangedBy", fields: [changedById], references: [id], onDelete: SetNull)
  previousSignal Signal?
  newSignal      Signal? // null = signal cleared back to "not set" (still audited)
  note           String?

  @@index([enrollmentId])
  @@map("signal_change_log")
}

enum OutcomeAchieved {
  JOB_OFFER_RECEIVED
  INTERVIEWS_ONLY
  APPLICATIONS_STAGE
  NO_OUTCOME_YET
}

model SatisfactionScore {
  id                  String          @id @default(cuid())
  studentId           String
  student             Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date                DateTime        @db.Date
  satisfactionScore   Int // 1–10
  npsScore            Int // 0–10
  testimonialReceived Boolean         @default(false)
  outcomeAchieved     OutcomeAchieved @default(NO_OUTCOME_YET)
  notes               String?
  createdAt           DateTime        @default(now())

  @@index([studentId])
  @@map("satisfaction_score")
}

// ───────────────────────────── Phase 3 - Conversion Funnel ─────────────────────────────

// Weekly snapshot (PRD3 §3.2). Awareness/GB downloads are always manual; leads/calls/
// proposals/enrollments are pre-filled from Phase 1+2 native queries, Admin can override.
model WeeklyFunnelSnapshot {
  id                String   @id @default(cuid())
  weekStart         DateTime @unique @db.Date // Monday
  awarenessReach    Int      @default(0)
  leadsCaptured     Int      @default(0)
  callsCompleted    Int      @default(0)
  proposalsSent     Int      @default(0)
  enrollmentsSolo   Int      @default(0)
  enrollmentsGuided Int      @default(0)
  enrollmentsElite  Int      @default(0)
  ghostedDownloads  Int      @default(0)
  workshopAttendees Int      @default(0)
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("weekly_funnel_snapshot")
}

// ───────────────────────────── Phase 3 - Cash Health ─────────────────────────────

// Weekly bank-balance log (PRD3 §4.1). Kept as history for the 12-week line chart.
model CashPosition {
  id                      String   @id @default(cuid())
  date                    DateTime @unique @db.Date // should be a Monday
  bankBalanceInrMinor     BigInt   @default(0)
  personalSavingsInrMinor BigInt? // optional, planning only - excluded from runway
  notes                   String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@map("cash_position")
}

enum PayableFrequency {
  MONTHLY
  QUARTERLY
  ANNUAL
  ONE_TIME
}

enum PayableStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

model Payable {
  id             String           @id @default(cuid())
  name           String
  category       ExpenseCategory
  amountInrMinor BigInt           @default(0)
  frequency      PayableFrequency @default(MONTHLY)
  nextDueDate    DateTime?        @db.Date
  isCogs         Boolean          @default(false)
  status         PayableStatus    @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status, nextDueDate])
  @@map("payable")
}

// ───────────────────────────── Phase 4 - German Note ─────────────────────────────
// LMS-lite for the German language program: Admin creates batches (A1..B2 cohorts)
// and assigns a TUTOR + Students. Classes are recorded by fathom.ai; the tutor
// pastes the Fathom share link (YouTube/Vimeo/Drive also accepted) into their
// batch. Students keep LIFETIME access to their batch's recordings - batch
// membership never expires; archiving a batch only closes its discussion.
// Community = Skool-style feed: GnPost.batchId null → global, set → batch.

enum GnBatchStatus {
  ACTIVE
  ARCHIVED
}

/// Which business line a batch belongs to (ER v2 Track A, decision D1).
///
/// D1 was "one Batch table or two". Unify: German Note already ran TWO batch worlds - real
/// `gn_batch` rows for the LMS, and free-text labels ("B26") typed onto
/// GnWorkshopConversion.batchA1/A2/B1. A separate B2 coaching batch would have made three.
/// One table, discriminated here, keeps "which batch is this person in" a single question.
enum BatchLine {
  B2 // coaching tiers - SOLO / GUIDED / ELITE
  GERMAN_NOTE // GN_A1 … GN_C2
}

enum GnVideoProvider {
  FATHOM // primary: classes are recorded by fathom.ai, tutor pastes the share link
  YOUTUBE
  VIMEO
  GDRIVE
}

/// A cohort, for EITHER business line (ER v2 `BATCH`; was `GnBatch`/`gn_batch`).
///
/// Renamed rather than recreated - the migration is an `ALTER TABLE ... RENAME`, so every
/// existing German Note batch, its roster, its recordings and its community posts survive
/// untouched. `line` defaults to GERMAN_NOTE precisely because every pre-existing row is one.
///
/// B2 coaching seats arrive through `Enrollment.batchId`; German Note seats keep arriving
/// through `BatchMember` (which references Student, so Admin can seat someone before any
/// portal login exists). That asymmetry is deliberate: a B2 seat IS the enrollment, whereas a
/// GN student may sit in a batch for a level they were gifted or repeated.
model Batch {
  id        String        @id @default(cuid())
  /// Which business this cohort belongs to. Guards level-kind compatibility at the service
  /// layer (COACHING_TIER → B2, GERMAN_LEVEL/GERMAN_BUNDLE → GERMAN_NOTE).
  line      BatchLine     @default(GERMAN_NOTE)
  /// The founders' own label - "A1", "B10", "B26". Nullable because pre-existing rows have
  /// none, unique because it is the human key they use on calls and in the workbooks.
  code      String?       @unique
  name      String // "A1 Evening - July 2026"
  level     String // Level.code - service-validated against `line`
  tutorId   String?
  tutor     User?         @relation("BatchTutor", fields: [tutorId], references: [id], onDelete: SetNull)
  status         GnBatchStatus @default(ACTIVE)
  targetStrength Int           @default(8) // target class size (spec: ~8 per batch)
  /// ER v2 BATCH.start_date. Nullable: the GN batches that already exist were never asked for one.
  startDate      DateTime?     @db.Date
  endDate        DateTime?     @db.Date
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  members    BatchMember[]
  enrollments    Enrollment[]
  pendingJoiners GnPendingJoiner[]
  recordings GnRecording[]
  posts      GnPost[]
  modules    GnModule[]
  events     ClassSession[]
  tutorFees      TutorFee[]
  /// Workshop conversions whose per-level batch label resolved to this row (Track A backfill).
  conversionsA1  GnWorkshopConversion[] @relation("ConversionBatchA1")
  conversionsA2  GnWorkshopConversion[] @relation("ConversionBatchA2")
  conversionsB1  GnWorkshopConversion[] @relation("ConversionBatchB1")

  @@index([status])
  @@index([tutorId])
  @@index([line, status])
  @@map("batch")
}

// Classroom curriculum: an ordered section grouping a batch's lessons
// (recordings). Recordings with moduleId null fall into the default section.
model GnModule {
  id         String   @id @default(cuid())
  batchId    String
  batch      Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  title      String
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  recordings GnRecording[]

  @@index([batchId, orderIndex])
  @@map("gn_module")
}

// The kind of session a calendar event represents (spec: kickoff / coaching /
// LinkedIn / Q&A / open-market strategy). LIVE_CLASS is the German-Note default.
enum GnEventType {
  KICKOFF
  COACHING
  LINKEDIN
  QA
  OPEN_MARKET
  LIVE_CLASS
  OTHER
}

/// ER v2 `SESSION` (was `GnEvent`/`gn_event`). A scheduled class or coaching session on a
/// batch's calendar. Students see upcoming + a join link; the recording is posted afterwards.
///
/// NAMED `ClassSession`, NOT `Session`: `model Session` is Better Auth's login-session table
/// (`@@map("session")`). Same collision, same resolution as `LedgerAccount` vs Better Auth's
/// `Account` - see the note on that model. The table is `class_session`.
///
/// `GnEventType` already carried the diagram's exact session vocabulary
/// (KICKOFF / COACHING / LINKEDIN / QA / OPEN_MARKET), so the enum is reused verbatim.
model ClassSession {
  id           String      @id @default(cuid())
  batchId      String
  batch        Batch       @relation(fields: [batchId], references: [id], onDelete: Cascade)
  title        String
  type         GnEventType @default(LIVE_CLASS)
  startsAt     DateTime
  durationMins Int?
  joinUrl      String?
  notes        String?
  /// ER v2 `SESSION ||--o| RECORDING`. Set when the tutor posts the class recording, so
  /// "which session is this video of" stops being inferred from the date.
  recordingId  String?      @unique
  recording    GnRecording? @relation("SessionRecording", fields: [recordingId], references: [id], onDelete: SetNull)
  createdById  String?
  createdBy    User?    @relation("GnEventCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tasks SessionTask[]
  attendance SessionAttendance[]

  @@index([batchId, startsAt])
  @@map("class_session")
}

/// What a session's coursework asks the student to do (ER v2 TASK.type).
enum SessionTaskType {
  WATCH_VIDEO
  APPLY_JOB
  HOMEWORK
  OTHER
}

/// ER v2 `TASK`. Coursework hung off a session.
///
/// DELIBERATELY NOT `ContactTask`. That model is the CRM to-do on a *Lead* ("call Priya back
/// Thursday"); this is what a *student* was assigned in class. Collapsing them would put a
/// sales follow-up in someone's homework list and a homework item on the sales board.
model SessionTask {
  id          String          @id @default(cuid())
  sessionId   String
  session     ClassSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type        SessionTaskType @default(HOMEWORK)
  title       String
  description String?
  dueAt       DateTime?
  /// For WATCH_VIDEO: which recording. Completion can then be derived from watch progress
  /// rather than taken on trust (see lib/video-progress.ts).
  recordingId String?
  recording   GnRecording?    @relation("TaskRecording", fields: [recordingId], references: [id], onDelete: SetNull)
  orderIndex  Int             @default(0)
  createdById String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  completions SessionTaskCompletion[]

  @@index([sessionId, orderIndex])
  @@index([recordingId])
  @@map("session_task")
}

/// ER v2 `TASK_COMPLETION`. One row per (task × student), MATERIALISED when the task is
/// assigned rather than computed on read.
///
/// Materialised on purpose: a derived "students who haven't done it" set cannot answer
/// "what did I miss while I was away", because it has no memory of what was outstanding
/// when. Seating a student into a batch backfills their missing rows.
model SessionTaskCompletion {
  id          String         @id @default(cuid())
  taskId      String
  task        SessionTask    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status      TaskCompletion @default(PENDING) // reuses the existing YES / NO / PENDING enum
  completedAt DateTime?
  /// True when the status was derived from watch progress rather than ticked by the student.
  autoCompleted Boolean      @default(false)
  note        String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([taskId, studentId])
  @@index([studentId, status])
  @@map("session_task_completion")
}

/// Was this student in the room?
///
/// LATE and EXCUSED are separate from PRESENT and ABSENT because they answer different
/// questions and a two-value enum forces one of them to be a lie. A student who joined 20
/// minutes late attended; a student excused for a funeral did not attend but is not at risk.
/// Collapsing either into ABSENT would put them in the drop-risk list, which is the one list
/// this data exists to produce.
enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  EXCUSED
}

/// Who actually showed up to a class.
///
/// THE GAP THIS CLOSES: tutor fees are computed against `Batch._count.members +
/// _count.enrollments` - the ROSTER. So the business pays per head enrolled while having no
/// record at all of heads present, and two other things sit blocked behind that absence: a
/// drop-risk signal derived from behaviour rather than hand-set by a coach, and a no-show rate.
///
/// MATERIALISED when a session's sheet is opened, exactly like `SessionTaskCompletion` above and
/// for the same reason: a derived "who is missing" set has no memory of who was EXPECTED at a
/// session whose roster has since changed. A student who left the batch in September must still
/// appear as absent from August's class, and only a stored row can say that.
///
/// NOTE ON THE FEE: this model deliberately does NOT change how tutor fees are computed. Moving a
/// fee from roster-based to attendance-based is a pricing decision for the founders, not a
/// side-effect of recording attendance. The fee row now shows both numbers so the gap is visible.
model SessionAttendance {
  id        String       @id @default(cuid())
  sessionId String
  session   ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId String
  student   Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  /// PENDING has no representation here on purpose. A sheet that has never been opened has no
  /// rows at all, which is a different (and honest) state from "we looked and they were absent" -
  /// and it keeps an unmarked session from silently counting against every student's rate.
  status AttendanceStatus

  /// Optional richer signal for a video class where the platform reports it. Null when the tutor
  /// simply ticked a box, which is the normal case.
  minutesAttended Int?
  note            String?

  /// SetNull like every other actor link on a record that matters: removing a tutor's login must
  /// never delete the evidence of who marked a register.
  markedById String?
  markedBy   User?    @relation("AttendanceMarkedBy", fields: [markedById], references: [id], onDelete: SetNull)
  markedAt   DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One verdict per student per session - the register, not a log of edits. A correction
  /// updates the row; the activity log carries the history.
  @@unique([sessionId, studentId])
  @@index([studentId, status])
  @@index([sessionId])
  @@map("session_attendance")
}

// Members reference Student (not User) so Admin can add people before any
// portal login exists; the existing createStudentLogin flow links a User later.
model BatchMember {
  id        String   @id @default(cuid())
  batchId   String
  batch     Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  addedAt   DateTime @default(now())

  @@unique([batchId, studentId])
  @@index([studentId])
  @@map("batch_member")
}

model GnRecording {
  id         String          @id @default(cuid())
  batchId    String
  batch      Batch           @relation(fields: [batchId], references: [id], onDelete: Cascade)
  moduleId   String? // classroom section; null = default "Class recordings"
  module     GnModule?       @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  title      String
  classDate  DateTime        @db.Date
  videoUrl   String // original pasted URL ("open original" link)
  provider   GnVideoProvider
  embedUrl   String // derived iframe src, stored at write time
  notes      String?
  postedById String?
  postedBy   User?           @relation("GnRecordingPostedBy", fields: [postedById], references: [id], onDelete: SetNull)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  watches GnRecordingWatch[]
  /// The scheduled session this is the recording OF (ER v2 SESSION ||--o| RECORDING).
  session ClassSession?     @relation("SessionRecording")
  /// WATCH_VIDEO tasks pointing at this clip.
  tasks   SessionTask[]     @relation("TaskRecording")

  @@index([batchId, classDate])
  @@index([moduleId])
  @@map("gn_recording")
}

// Per-viewer "watched" state → the batch progress bar + completion checkmarks.
// Recordings are lifetime, so this is progress, not access control.
model GnRecordingWatch {
  id          String      @id @default(cuid())
  recordingId String
  recording   GnRecording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  userId      String
  user        User        @relation("GnRecordingWatchUser", fields: [userId], references: [id], onDelete: Cascade)
  /// When the student SAID they watched it (the tick). Kept, but no longer the truth.
  watchedAt   DateTime    @default(now())
  /// Whether the student actually ticked "watched". Previously implied by the row existing -
  /// but tracking now creates rows too, so the claim needs saying out loud. Defaults true so
  /// every pre-existing row (which could only have come from a tick) keeps its meaning.
  selfReported Boolean    @default(true)

  /// Spec §10.3: "the tracked percentage is the source of truth" over a self-reported
  /// 'watched'. 0–100, high-water mark - scrubbing backwards must not erase progress.
  /// Null = never tracked (a legacy tick, or a host that reports no progress), which is
  /// why this is nullable rather than 0: "unknown" and "watched none" are different claims.
  watchedPct      Int?
  /// Furthest position reached and the clip length, both in whole seconds - kept so a
  /// percentage can be re-derived and audited rather than taken on faith.
  positionSecs    Int?
  durationSecs    Int?
  lastHeartbeatAt DateTime?

  @@unique([recordingId, userId])
  @@index([userId])
  @@map("gn_recording_watch")
}

// Skool-style post categories - power the filter chips on the feed.
enum GnPostCategory {
  GENERAL
  ANNOUNCEMENT
  QUESTION
  WIN
}

// Authors are SetNull so revoking a login never destroys community content -
// UI renders "Former member" when author is null. Feed order is Skool-like:
// pinned first, then by latest activity (a new comment bumps the post).
model GnPost {
  id               String         @id @default(cuid())
  batchId          String? // null = global GN community feed; set = batch discussion
  batch            Batch?         @relation(fields: [batchId], references: [id], onDelete: Cascade)
  authorId         String?
  author           User?          @relation("GnPostAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  title            String? // Skool posts lead with a bold title; optional for quick questions
  category         GnPostCategory @default(GENERAL)
  pinned           Boolean        @default(false) // Admin (global) / batch tutor (batch) pin posts to the top
  body             String
  imageUrl         String? // optional single image, stored as a resized data URL (like avatars)
  mentionedUserIds String[] // @mention targets, resolved server-side → notifications
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  comments GnComment[]
  likes    GnLike[]

  @@index([batchId, createdAt])
  @@map("gn_post")
}

model GnComment {
  id               String   @id @default(cuid())
  postId           String
  post             GnPost   @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId         String?
  author           User?    @relation("GnCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  body             String
  mentionedUserIds String[]
  createdAt        DateTime @default(now())

  likes GnCommentLike[]

  @@index([postId, createdAt])
  @@map("gn_comment")
}

model GnLike {
  id        String   @id @default(cuid())
  postId    String
  post      GnPost   @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("GnLikeUser", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@map("gn_like")
}

// Comment likes - separate table from post likes; both feed community points/levels.
model GnCommentLike {
  id        String    @id @default(cuid())
  commentId String
  comment   GnComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation("GnCommentLikeUser", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@unique([commentId, userId])
  @@map("gn_comment_like")
}

// ── German Note - Workshops → conversions by level ─────────────
// A workshop is a paid-ad intake (e.g. "May 2026"): people attend a free
// German taster, and a share convert into a level course (A1 / A2 / B1 or a
// bundle). Reverse-engineered from the founders' monthly workshop workbooks -
// the conversions table, the ad-performance block and the P&L rollup.
// Admin-only, like the rest of German Note management. Money = INR paise.

enum GnWorkshopStatus {
  ACTIVE
  ARCHIVED
}

// The "Product Chosen" dropdown: single levels + the discounted bundles.
enum GnWorkshopProduct {
  A1
  A2
  B1
  A1_A2
  A2_B1
  A1_A2_B1
}

enum GnWorkshopDayType {
  WEEKDAY
  WEEKEND
}

// A confirmed sale still awaiting start/settlement shows as ON_HOLD in the sheet.
enum GnConversionStatus {
  CONFIRMED
  ON_HOLD
}

// How the conversion reached us - drives ad-spend attribution. AD conversions
// split the workshop's ad spend between them; ORGANIC ones carry no ad cost.
enum GnWorkshopSource {
  AD
  ORGANIC
}

/// ER v2 `WORKSHOP` (was `GnWorkshop`/`gn_workshop`). Generalised beyond German Note by
/// `line`, and given the three fields the diagram asks for and the founders actually use:
/// the landing page the ad points at, the WhatsApp group registrants are pushed into, and
/// the instant the taster runs (distinct from `month`, which is the intake period).
model Workshop {
  id        String           @id @default(cuid())
  line      BatchLine        @default(GERMAN_NOTE)
  name      String // "May 2026"
  month     DateTime         @db.Date // first of the intake month - drives ordering
  status    GnWorkshopStatus @default(ACTIVE)
  landingPageUrl    String?
  whatsappGroupLink String?
  scheduledAt       DateTime?
  notes     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  conversions GnWorkshopConversion[]
  adSets      AdSpend[]
  registrations WorkshopRegistration[]
  pendingJoiners GnPendingJoiner[]

  @@index([status])
  @@index([line, month])
  @@map("workshop")
}

/// ER v2 `WORKSHOP_REGISTRATION` - one row per PERSON who registered, linked to their Lead.
///
/// Why this had to exist: attendance was an integer typed onto the ad set, and only people
/// who *converted* got a row. "Who attended and didn't buy, and can we re-target them" was
/// therefore unanswerable - despite the pipeline carrying SENT_TO_WORKSHOP and
/// WORKSHOP_FOLLOWUP stages built for exactly that motion.
///
/// `leadId` is SetNull, not Cascade: a registration is evidence that someone turned up, and
/// must survive the lead being merged or archived.
model WorkshopRegistration {
  id         String    @id @default(cuid())
  workshopId String
  workshop   Workshop  @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  leadId     String?
  lead       Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  /// Snapshotted at registration - the lead row may later be corrected or merged.
  name       String
  email      String?
  phone      String?
  registeredAt DateTime @default(now())
  attended   Boolean   @default(false)
  attendedAt DateTime?
  source     Source    @default(NATIVE_FORM)
  externalRef String?
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  conversion GnWorkshopConversion?

  /// One registration per lead per workshop - makes a replayed webhook idempotent.
  @@unique([workshopId, leadId])
  @@index([workshopId, attended])
  @@index([leadId])
  @@map("workshop_registration")
}

/// ER v2 `AD_SPEND` (was `GnWorkshopAdSet`/`gn_workshop_adset`). Generalised twice over:
///   - `sourceId` lets spend attach to a MarketingSource (a campaign) and not only a
///     workshop, so "what did the Instagram campaign cost per enrolment" is answerable;
///   - dual currency, because the diagram asks for EUR|INR and the old model was INR-only
///     even though B2 runs euro ad accounts.
/// `workshopId` stays so the German Note ad-performance panel keeps working unchanged.
model AdSpend {
  id              String     @id @default(cuid())
  workshopId      String?
  workshop        Workshop?  @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  sourceId        String?
  source          MarketingSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  label           String? // "Set A", optional
  /// Kept as the INR field the GN panel already reads; `amountEurMinor` + `fxRateUsed` are
  /// the additive half, defaulted so every historical row keeps its exact meaning.
  adSpendInrMinor BigInt     @default(0) // paise
  amountEurMinor  BigInt     @default(0) // cents
  fxRateUsed      Decimal?   @db.Decimal(14, 6)
  periodStart     DateTime?  @db.Date
  periodEnd       DateTime?  @db.Date
  reach           Int        @default(0)
  linkClicks      Int        @default(0)
  attended        Int        @default(0) // registrations / attendees on the taster
  conversions     Int        @default(0) // deals closed attributed to this set
  orderIndex      Int        @default(0)
  createdAt       DateTime   @default(now())

  @@index([workshopId])
  @@index([sourceId, periodStart])
  @@map("ad_spend")
}

// One client who converted from the workshop into a level course.
// COGS = books + tutor; Gross = final − COGS; Total Exp = COGS + ads + referral;
// Net = final − Total Exp; ROAS = final ÷ ads. (Verified against the sheet rollup.)
model GnWorkshopConversion {
  id                        String             @id @default(cuid())
  workshopId                String
  workshop                  Workshop           @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  /// The registration this sale came from (Track G). Nullable + unique: historical rows were
  /// entered straight from the workbook with no registration behind them, and one
  /// registration can convert at most once.
  registrationId            String?               @unique
  registration              WorkshopRegistration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  fullName                  String
  email                     String?
  phone                     String?
  address                   String?
  product                   GnWorkshopProduct
  dayType                   GnWorkshopDayType  @default(WEEKDAY)
  // per-level batch assignment (label + time), free-text like the sheet ("B26", "7:00 AM").
  // Kept as the historical SNAPSHOT of what the workbook said; the *Id columns beside them
  // are the resolved links the Track A backfill writes. A label the backfill could not
  // resolve stays here with a null Id and is surfaced in the UI as "unlinked" - never guessed.
  batchA1                   String?
  batchA1Id                 String?
  batchA1Ref                Batch?             @relation("ConversionBatchA1", fields: [batchA1Id], references: [id], onDelete: SetNull)
  timeA1                    String?
  batchA2                   String?
  batchA2Id                 String?
  batchA2Ref                Batch?             @relation("ConversionBatchA2", fields: [batchA2Id], references: [id], onDelete: SetNull)
  timeA2                    String?
  batchB1                   String?
  batchB1Id                 String?
  batchB1Ref                Batch?             @relation("ConversionBatchB1", fields: [batchB1Id], references: [id], onDelete: SetNull)
  timeB1                    String?
  source                    GnWorkshopSource   @default(AD) // AD = from the workshop ad campaign; ORGANIC = referral / carry-over / free
  status                    GnConversionStatus @default(CONFIRMED)
  isFreeSeat                Boolean            @default(false) // B2-client / free-repeat seat (₹0 revenue; cost still applies)
  finalPriceInrMinor        BigInt             @default(0) // billed price (paise) - an INPUT: varies per deal (EMI / negotiation)
  paidAmountInrMinor        BigInt             @default(0) // cash collected (paise); balance = paid − final
  paymentMethod             String? // "UPI", "Credit Card", "German Bank", "UPI · 6 EMI"…
  nextDueDate               DateTime?          @db.Date
  // Costs are DERIVED from the product via the level cost model (lib/gn-workshop-pricing).
  // These override the model only for genuine exceptions (null → use the model). Ad spend
  // is DERIVED at read time: workshop ad-set spend ÷ its AD conversions.
  booksCostOverrideInrMinor BigInt?
  tutorCostOverrideInrMinor BigInt?
  referralInrMinor          BigInt             @default(0)
  notes                     String?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt

  @@index([workshopId])
  @@map("gn_workshop_conversion")
}

// ───────────────────────────── Cross-cutting ─────────────────────────────

// Daily ECB rate cache (frankfurter.app). One row per day; each money record
// stamps the rate it used so history never shifts.
model FxRate {
  id        String   @id @default(cuid())
  date      DateTime @unique @db.Date
  inrPerEur Decimal  @db.Decimal(14, 6)
  provider  String   @default("frankfurter.app")
  fetchedAt DateTime @default(now())

  @@map("fx_rate")
}

// ───────────────────────────── Invites ─────────────────────────────
// Public sign-up is off: an Admin provisions the account, and the person sets their own
// password through a single-use link. Nobody - not even the Admin who invited them -
// ever knows their password.
//
// Only the SHA-256 of the token is stored, so a leaked database row cannot be redeemed.
// One row per user (`userId @unique`): re-inviting replaces the old token, which
// instantly invalidates any link already sent.
model UserInvite {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation("UserInviteFor", fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime? // set once redeemed - a link is good for exactly one use
  createdById String?
  createdBy   User?     @relation("UserInviteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@index([expiresAt])
  @@map("user_invite")
}

// ───────────────────────────── Founder console - goals & rewards ─────────────────────────────
// The founder steers the team with GOALS ("₹12L revenue this quarter", "Asma: 40 discovery
// calls in July") and pays for outcomes with REWARD RULES ("30-day streak → ₹2,000").
//
// Neither stores progress. A goal's actual and a rule's qualifiers are DERIVED on read from
// the same append-only history the Arena scores (daily logs, stage moves, milestone logs), so
// nothing here can drift out of sync with the work that was actually done.

enum GoalScope {
  COMPANY // judged on the whole team's combined total
  USER // judged on one person's total
}

enum GoalPeriod {
  MONTH
  QUARTER
  YEAR
}

model Goal {
  id            String       @id @default(cuid())
  name          String
  // A key from GOAL_METRICS in src/lib/goals.ts (e.g. "wins", "xp", "revenueInr"). Text, not an
  // enum: the vocabulary is derived from the gamification engine, and adding a metric there
  // shouldn't force a database migration.
  metric        String
  scope         GoalScope    @default(COMPANY)
  teamProfileId String? // set when scope = USER
  teamProfile   TeamProfile? @relation(fields: [teamProfileId], references: [id], onDelete: Cascade)
  period        GoalPeriod   @default(MONTH)
  periodStart   DateTime     @db.Date // first day of the month / quarter / year
  targetValue   Decimal      @db.Decimal(16, 2)
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([active, periodStart])
  @@index([teamProfileId])
  @@map("goal")
}

enum RewardKind {
  BONUS
  COMMISSION
  PERK // a thing, not a payout - amounts stay zero
}

enum RewardGrantStatus {
  PENDING // auto-detected, waiting on the founder
  APPROVED // founder said yes; not yet paid out
  DECLINED // founder said no - never re-offered
  PAID
}

model RewardRule {
  id             String     @id @default(cuid())
  name           String
  description    String
  kind           RewardKind @default(BONUS)
  active         Boolean    @default(true)
  // A RewardTrigger from src/lib/rewards.ts, validated by rewardTriggerSchema on write.
  trigger        Json
  roles          Role[] // empty = every role plays
  amountInrMinor BigInt     @default(0) // paise
  amountEurMinor BigInt     @default(0) // cents
  perkLabel      String? // what they get when kind = PERK
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  grants RewardGrant[]

  @@index([active])
  @@map("reward_rule")
}

// One person, one rule, one period. `periodKey` is derived from the trigger (a badge key, a
// level, a month…) - see src/lib/rewards.ts. The unique constraint below is what makes a
// re-scan idempotent: re-deriving every qualification in history inserts nothing new, so a
// rule can be edited and rescanned without ever double-paying, and a DECLINED grant stays
// declined instead of reappearing as PENDING.
model RewardGrant {
  id             String            @id @default(cuid())
  ruleId         String
  rule           RewardRule        @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  teamProfileId  String
  teamProfile    TeamProfile       @relation(fields: [teamProfileId], references: [id], onDelete: Cascade)
  periodKey      String
  qualifiedOn    DateTime          @db.Date
  reason         String
  status         RewardGrantStatus @default(PENDING)
  // Amounts are copied off the rule and the rate stamped at grant time, so later edits to the
  // rule (or a move in the FX rate) never re-price what someone already earned.
  amountInrMinor BigInt            @default(0)
  amountEurMinor BigInt            @default(0)
  fxRateUsed     Decimal           @db.Decimal(14, 6)
  decidedById    String?
  decidedBy      User?             @relation("RewardGrantDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt      DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([ruleId, teamProfileId, periodKey])
  @@index([status, qualifiedOn])
  @@index([teamProfileId])
  @@map("reward_grant")
}

// Small key/value store: runway growth-rate override, ingest feature flags, etc.
// Founder-console keys: "sectionsConfig" (nav layout + role defaults),
// "gamificationRulesets" (the effective-dated XP/level/badge/quest rules).
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("app_setting")
}

// A recorded commission payout run (audit §C #23). getCommissionReport computes the deal-team
// split per payment at read time; this snapshots a month's per-person totals so a run is a durable
// artefact, not a screen the founder eyeballs. Admin-triggered (finance.write) - never a cron.
// `postedEntryId` links the optional Dr Team-salaries / Cr Accounts-payable accrual (an accrual,
// not a cash payment) when financePosting.commissionAccrual is on. `createdById` is a bare scalar,
// not an FK - the activity log is the durable record of who ran it. Unique per month = idempotent.
model CommissionPayoutRun {
  id            String   @id @default(cuid())
  month         DateTime @unique @db.Date // first-of-month this run snapshots
  totalInrMinor BigInt   @default(0)
  lines         Json // [{ name, amountInrMinor, deals }] per person, snapshotted at run time
  postedEntryId String? // journal entry id when accrued to the ledger (else null)
  createdById   String?
  createdAt     DateTime @default(now())

  @@map("commission_payout_run")
}

// ───────────────────────────── Wave-2 - WhatsApp (WATI) ─────────────────────────────
// Outbound WhatsApp via the WATI Business API BSP (the "Wave-2, gated on Ameen's sign-off"
// messaging the Wave-1 comments anticipated). Everything here is INERT unless WATI_ENABLED
// is set AND credentials + template names are configured: with the flag off every send is a
// no-op that still writes a SKIPPED row so the history is honest. Business-initiated messages
// are always pre-approved WhatsApp *templates* (24h-window rule); numbers are stored normalized
// (digits + country code) and STOP replies write a WhatsAppOptOut that blocks all future sends.

enum WhatsAppDirection {
  OUTBOUND
  INBOUND
}

// One value per lifecycle touchpoint (§ "all touchpoints"). MANUAL = a one-off send a human
// triggered from a section row; the rest are the automatic reminder cadence.
enum WhatsAppKind {
  DISCO_REMINDER // funnel: nudge an un-booked lead to book the discovery call
  BOOKING_CONFIRMATION // a slot was just booked
  BOOKING_REMINDER // pre-call reminder (~24h / ~1h before the slot)
  NO_SHOW_FOLLOWUP // missed the call - rebook
  PAYMENT_REMINDER // overdue pending payment / receivable
  EMI_PRE_DUE // instalment falls due in N days - the reminder that lands BEFORE the due date
  CHECKIN_NUDGE // student coaching check-in due
  SPRINT_MISS_NUDGE // student missed a sprint-week target
  AGREEMENT_SEND // coaching agreement is ready - carries the tokenized signing link
  AGREEMENT_OTP // 6-digit code binding the signature to control of this number
  AGREEMENT_REMINDER // an issued agreement is still unsigned
  // The countersigned copy, sent back the moment the student signs. Its OWN kind, not a reuse of
  // AGREEMENT_SEND: one WATI template is bound per kind, and that template carries the *signing*
  // link - the student would receive the wrong text and the section badges would misattribute the
  // send. This is also the row COMPLETED is derived from (see lib/agreement-state.ts).
  AGREEMENT_COPY // executed agreement - carries the link to the sealed, countersigned PDF
  MANUAL // free-form / manual send from a section
  // ── Outreach Specialist SOP (Steps 3–21). One kind per SOP message, deliberately.
  // The app binds exactly ONE WATI template per kind, so collapsing two SOP steps onto one kind
  // would send the wrong text for one of them. Nine SOP messages → nine kinds → nine templates.
  SOP_INTRO // Step 3  - WhatsApp introduction, immediately after opt-in
  SOP_FOLLOWUP // Step 6  - call not booked at the first booking check
  SOP_FOLLOWUP_2 // Step 7b - still not booked at the second check. Its OWN kind so the
  // founder can bind a differently-worded template later without touching Step 6's.
  SOP_NOT_QUALIFIED // Step 13c - BANT below the bar; the booked call is being cancelled
  SOP_DISCO_WELCOME // Step 13 - qualified YES/MAYBE, disco call booked
  SOP_DISCO_CONFIRM_1 // Step 14 - ≥36h before the disco call
  SOP_DISCO_CONFIRM_2 // Step 15 - ≥24h before, no reply to Step 14
  SOP_DISCO_CANCEL // Step 16 - ≥12h before, unconfirmed after two calls
  SOP_SSS_CONFIRM_1 // Step 19 - ≥24h before the SSS, carries the personalized video
  SOP_SSS_CONFIRM_2 // Step 20 - ≥12h before the SSS, no reply to Step 19
  SOP_SSS_CANCEL // Step 21 - ≥10h before the SSS, still unconfirmed
  // ── Bookings confirmation loop (Module E). The in-house Bookings section's own confirm-or-cancel
  // cadence, independent of the Outreach SOP ladder above (which runs off a separate OutreachJourney).
  BOOKING_CONFIRM_REQUEST // asks the prospect to reply YES to hold their upcoming slot
  BOOKING_RESCHEDULED // their call was moved to a new time (manual postpone OR promoted-up)
  BOOKING_AUTO_CANCELLED // no confirmation in time - slot released, invite to rebook
  // ── SSS (sales) call calendar. The founder-run session; server/sss-slots.ts.
  SSS_RESCHEDULED // their SSS was moved to a new time (founder blocked the slot/day, or a manual/drag move)
  // ── Book publisher orders. The ONLY touchpoint whose recipient is not a prospect or student:
  // this one goes to the VENDOR's number. That is why its variables carry the student's name and
  // ship-to rather than addressing the recipient as the subject.
  BOOK_ORDER // order for a student's level books, sent to the publisher/vendor
}

enum WhatsAppStatus {
  SKIPPED // flag off / unconfigured / opted-out / deduped - nothing left the app
  QUEUED
  SENT // accepted by WATI
  DELIVERED // WATI delivery callback
  READ // WATI read callback
  REPLIED // prospect replied (inbound) - "WhatsApp confirmed" (SALES-LOGIC §2)
  FAILED
}

// Append-only send/receive log. Doubles as the idempotency source (sentRecently checks the
// last row for a kind+target) and the per-row status badge shown across the sections.
model WhatsAppMessage {
  id            String            @id @default(cuid())
  direction     WhatsAppDirection @default(OUTBOUND)
  kind          WhatsAppKind
  status        WhatsAppStatus    @default(QUEUED)
  toNumber      String // normalized (digits incl. country code, no '+')
  templateName  String? // WATI approved template used (null for inbound / free text)
  body          String? // rendered summary (outbound) or message text (inbound)
  params        Json? // template variables sent, for audit/debug
  watiMessageId String? // WATI id - matched by the status-callback webhook
  error         String? // failure reason when status = FAILED

  // Optional links to whatever this message was about (all SetNull - a message row must
  // survive deletion of the lead/student it referenced, like the rest of the audit tables).
  leadId           String?
  lead             Lead?           @relation(fields: [leadId], references: [id], onDelete: SetNull)
  studentId        String?
  student          Student?        @relation(fields: [studentId], references: [id], onDelete: SetNull)
  bookingRequestId String?
  bookingRequest   BookingRequest? @relation(fields: [bookingRequestId], references: [id], onDelete: SetNull)
  pendingPaymentId String?
  pendingPayment   PendingPayment? @relation(fields: [pendingPaymentId], references: [id], onDelete: SetNull)
  agreementId      String?
  agreement        Agreement?      @relation(fields: [agreementId], references: [id], onDelete: SetNull)
  bookOrderId      String?
  bookOrder        BookOrder?      @relation(fields: [bookOrderId], references: [id], onDelete: SetNull)

  sentById String? // the admin/user who triggered a manual send (null = automatic)
  sentBy   User?   @relation("WhatsAppSentBy", fields: [sentById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind, createdAt])
  @@index([leadId])
  @@index([studentId])
  @@index([bookingRequestId])
  @@index([pendingPaymentId])
  @@index([agreementId])
  @@index([bookOrderId])
  @@index([watiMessageId])
  @@index([toNumber])
  @@map("whatsapp_message")
}

// Phone-keyed opt-out (WhatsApp STOP / DPDP + GDPR). Checked before every send; written by
// the inbound webhook on a STOP-style reply and toggleable by Admin in the WhatsApp settings.
model WhatsAppOptOut {
  phone     String   @id // normalized, same shape as WhatsAppMessage.toNumber
  reason    String?
  createdAt DateTime @default(now())

  @@map("whatsapp_opt_out")
}

// ─────────────────────────────── Agreements (e-signature) ───────────────────────────────
//
// The founder fills a field form, signs, and WhatsApps a tokenized link; the student verifies a
// one-time code sent to the same number, signs on a canvas, and the PDF is rendered ONCE and
// sealed into `pdfBytes`.
//
// Two independent integrity claims, because they answer different questions:
//   dataSha256 - SHA-256 of the canonical JSON of `data` + `templateVersion`. Deterministic and
//                reproducible forever: it proves WHAT WAS AGREED. Printed on every page.
//   pdfSha256  - SHA-256 of the sealed bytes. It proves THE STORED ARTIFACT IS UNTOUCHED.
//                It is NOT reproducible: PDFKit stamps a creation date and document id, so
//                re-rendering identical data yields different bytes. Never re-render to verify.
//
// `data` is a frozen snapshot on purpose. The document must show what was true at signing, so
// rendering never joins back to the mutable Student row. It also carries the two fields the rest
// of the schema has no home for: the student's postal address and the programme batch.

enum AgreementStatus {
  DRAFT // founder is still editing; no token exists
  SENT // countersigned + link delivered; awaiting the student
  VIEWED // the student opened the link at least once
  SIGNED // sealed - pdfBytes + pdfSha256 are set and never change
  DECLINED // the student explicitly refused
  VOIDED // superseded or cancelled by the founder
  EXPIRED // the token's TTL elapsed unsigned
}

// Append-only trail. This IS the audit certificate: without it a canvas squiggle proves nothing.
enum AgreementEventType {
  CREATED
  ISSUED // founder countersigned and sent
  DELIVERY_SENT // handed to WATI
  DELIVERY_SKIPPED // WATI off / opted-out / no valid number - the founder must be told
  VIEWED
  OTP_SENT
  OTP_VERIFIED
  OTP_FAILED
  SIGNED
  DECLINED
  VOIDED
  COPY_DOWNLOADED
}

model Agreement {
  id              String          @id @default(cuid())
  documentNo      String          @unique // human reference, printed on every page: B2-GM-2026-0001
  templateVersion String // git-pinned renderer, e.g. "guided-v3"
  status          AgreementStatus @default(DRAFT)

  // Who it is for. SetNull like every other audit link: a signed agreement outlives its student row.
  studentId String?
  student   Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  /// ER v2 `ENROLLMENT ||--|| AGREEMENT` (Track E). Additive; `studentId` stays. Which LEVEL
  /// this contract governs was previously only readable out of the frozen `data` blob.
  enrollmentId String?
  enrollment   Enrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)

  data       Json // frozen AgreementData - validated by agreementDataSchema, never re-joined
  dataSha256 String // canonical-JSON hash of (data + templateVersion)

  // Signing link. Same shape as UserInvite: only the SHA-256 lands in the database, so a leaked
  // row cannot be redeemed. `signedAt` doubles as the single-use burn marker (compare-and-set).
  tokenHash String?   @unique
  expiresAt DateTime?

  issuedById          String?
  issuedBy            User?     @relation("AgreementIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)
  issuedAt            DateTime?
  founderSignedAt     DateTime?
  founderSignaturePng Bytes?
  founderDevice       Json? // same shape as signerDevice, captured when the founder countersigns

  signedAt            DateTime? // also the burn marker - never set twice
  studentSignaturePng Bytes?
  // How the signature was physically made. Three parts, and the distinction is the whole point:
  // what the browser CLAIMS about itself, how the strokes were actually drawn, and - the only
  // half a disputing counterparty cannot rewrite - the IP and User-Agent our server OBSERVED.
  // See src/lib/device.ts. Frozen by the seal trigger; printed on the certificate.
  signerDevice        Json?
  declinedAt          DateTime?
  declineReason       String?
  voidedAt            DateTime?

  // OTP that binds the signature to control of the delivery number. Hashed, single-window,
  // attempt-capped. Cleared on success so a replayed code is worthless.
  otpHash      String?
  otpExpiresAt DateTime?
  otpAttempts  Int       @default(0)

  // The sealed artifact. Written exactly once, at signing. `bytea` rather than object storage:
  // link-only delivery means no public URL is ever needed, and the document carries the student's
  // home address and B2's IBANs. NEVER select pdfBytes in a list query.
  pdfBytes  Bytes?
  pdfSha256 String?
  pdfSize   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events           AgreementEvent[]
  whatsappMessages WhatsAppMessage[]

  @@index([status, createdAt])
  @@index([studentId])
  @@index([leadId])
  @@index([enrollmentId])
  @@index([expiresAt])
  @@map("agreement")
}

// Append-only (DB trigger, see the agreements migration). No updatedAt - matches milestone_log,
// signal_change_log and the rest of the immutable-history tables.
model AgreementEvent {
  id          String             @id @default(cuid())
  agreementId String
  agreement   Agreement          @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  type        AgreementEventType
  ip          String?
  userAgent   String?
  meta        Json?
  createdAt   DateTime           @default(now())

  @@index([agreementId, createdAt])
  @@map("agreement_event")
}

// ───────────────────────── Accounting engine (SPEC §10) ─────────────────────────
//
// The double-entry general ledger. Finance and Cash Health are the *face*; this is
// the *engine*. Every money figure on every screen must trace to a balanced entry
// here - the UI never writes a balance directly (SPEC §10.1, principle 3).
//
// WHY THE NAME `LedgerAccount` AND NOT `Account`: `Account` is Better Auth's OAuth /
// credentials table (see `model Account`, @@map("account")). The chart of accounts is
// a completely different thing that happens to want the same word.
//
// MULTI-CURRENCY RULE (SPEC §10.1): a line carries its own currency and the FX rate at
// transaction time; the entry balances in the BASE currency (INR paise). We never
// re-derive history from today's rate. `baseDebitMinor`/`baseCreditMinor` are the
// INR-equivalent at `fxRate`, and Σbase-debits = Σbase-credits is enforced by a
// deferred constraint trigger at COMMIT - not just in application code.

enum LedgerAccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum Currency {
  INR
  EUR
}

enum JournalEntryStatus {
  POSTED
  VOID
}

// Where an entry came from. `(sourceType, sourceId)` is unique, so a given Income row
// can never be posted to the ledger twice - the guard against double-counting revenue.
enum LedgerSourceType {
  INCOME
  EXPENSE
  MANUAL
  OPENING_BALANCE
  FX_REVALUATION
  // Added so Payments-module money (currently disconnected from the ledger - see
  // docs/BUILD_CHECKLIST.md §7) has somewhere to post to. Adding these values is additive
  // and safe: forbid_duplicate_live_source() keys off sourceType/sourceId generically and
  // needs no change (see migrations/20260710143908_ledger_source_guard).
  INVOICE
  PAYMENT
  /// ER v2 Track C. An APPROVED tutor fee accrues Dr COGS / Cr Accounts-payable. Adding the
  /// value is additive and safe for the same reason INVOICE/PAYMENT were:
  /// forbid_duplicate_live_source() keys off (sourceType, sourceId) generically.
  TUTOR_FEE
}

// Chart of accounts, seeded for B2 in `prisma/chart-of-accounts.ts` (SPEC §10.1).
// `code` is the stable key the posting engine resolves against - never the name,
// which the founder may reword.
model LedgerAccount {
  id       String            @id @default(cuid())
  code     String            @unique
  name     String
  type     LedgerAccountType
  // null = accepts any currency (income/expense accounts); set = a real-world
  // account denominated in one currency, e.g. Bank (EUR).
  currency Currency?
  // COGS is a *reporting* flag on the account, mirroring Expense.isCogs, so gross
  // profit is a ledger slice rather than a second source of truth.
  isCogs   Boolean           @default(false)
  parentId String?
  parent   LedgerAccount?    @relation("LedgerAccountTree", fields: [parentId], references: [id], onDelete: SetNull)
  children LedgerAccount[]   @relation("LedgerAccountTree")
  archived Boolean           @default(false)
  sortKey  Int               @default(0)

  lines JournalLine[]

  @@index([type, code])
  @@map("ledger_account")
}

// A balanced journal entry. Append-only: corrections are made by VOIDing and posting a
// reversal (`reversalOfId`), never by editing history (SPEC §10.1, §12 audit rule).
model JournalEntry {
  id           String             @id @default(cuid())
  date         DateTime           @db.Date
  narration    String
  status       JournalEntryStatus @default(POSTED)
  sourceType   LedgerSourceType
  sourceId     String?
  // A VOID entry points at the entry it reverses; the reversal mirrors every line.
  reversalOfId String?            @unique
  reversalOf   JournalEntry?      @relation("JournalReversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversedBy   JournalEntry?      @relation("JournalReversal")
  postedById   String?
  postedBy     User?              @relation("JournalEntryPostedBy", fields: [postedById], references: [id], onDelete: SetNull)
  createdAt    DateTime           @default(now())

  lines JournalLine[]

  // At most one *live* (POSTED) entry per source row - enforced by the
  // `forbid_duplicate_live_source` trigger, not by a unique index.
  //
  // A plain UNIQUE(sourceType, sourceId) would be wrong: editing an Income voids its
  // entry and posts a restated one, and the voided original keeps its sourceId so the
  // trail stays traceable. The correct constraint is "unique among POSTED rows", i.e. a
  // partial index - which Prisma cannot express and would try to DROP on the next
  // `migrate dev`. Prisma does not manage triggers, so the guard lives there instead.
  @@index([sourceType, sourceId])
  @@index([date])
  @@index([status, date])
  @@map("journal_entry")
}

// One side of one entry. Exactly one of debit/credit is non-zero (CHECK constraint).
model JournalLine {
  id        String        @id @default(cuid())
  entryId   String
  entry     JournalEntry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId String
  account   LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  // Amounts as transacted, in `currency`'s minor units (paise / cents).
  debitMinor  BigInt   @default(0)
  creditMinor BigInt   @default(0)
  currency    Currency
  // INR per 1 unit of `currency`, stamped at transaction time. Always 1.0 for INR.
  fxRate      Decimal  @db.Decimal(14, 6)

  // The same amounts in base currency (INR paise). These are what must balance.
  baseDebitMinor  BigInt @default(0)
  baseCreditMinor BigInt @default(0)

  isCogs Boolean @default(false)

  @@index([entryId])
  @@index([accountId])
  @@map("journal_line")
}

// Admin closes a month; the posting engine then refuses any entry dated inside it,
// so a backdated edit can never silently restate a period Ameen has already read.
model PeriodLock {
  id         String   @id @default(cuid())
  // "YYYY-MM" in IST - the same key the Finance month picker uses.
  month      String   @unique
  lockedAt   DateTime @default(now())
  lockedById String?
  lockedBy   User?    @relation("PeriodLockedBy", fields: [lockedById], references: [id], onDelete: SetNull)
  note       String?

  @@map("period_lock")
}

// Immutable, hash-chained audit log (SPEC §10.1, §3 "from day one").
//
// `hash = sha256(prevHash || canonicalJson(payload))`, so altering or deleting any
// historical row breaks every hash after it. `seq` gives the chain its order.
// Append-only at the DB level too - see the migration's forbid_mutation() trigger.
model AuditEntry {
  seq        BigInt   @id @default(autoincrement())
  at         DateTime @default(now())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String
  payload    Json
  prevHash   String
  hash       String   @unique

  @@index([entityType, entityId])
  @@index([at])
  @@map("audit_entry")
}

// Who did what, when - every write in the app, in one place.
//
// Deliberately NOT AuditEntry: that chain exists to prove the finance history hasn't been
// tampered with, and it pays for that with a global advisory lock per append plus an O(n)
// verify the Ledger page runs on load. Feeding it a row per dial would serialise every
// writer on one lock and make that verify walk grow forever. This table is the plain
// counterpart - a row per action, written outside the caller's transaction, indexed for
// the founder's filters. Finance keeps writing to BOTH: the chain for proof, this for the feed.
//
// Append-only by the same forbid_mutation() trigger the other history tables use: the record
// of what Asma did at 3pm is worth nothing if it can be edited at 4pm.
//
// actorName/actorRole are denormalised on purpose. `actor` is SetNull on delete, so without
// the copy, removing a user would silently blank their entire history - the one moment the
// log matters most. The copy is what was true AT THE TIME, which is also the honest answer
// when someone's role changes later.
model ActivityLog {
  id         String   @id @default(cuid())
  // Server-stamped instant, never from the client. Rendered in IST (CONTEXT §6).
  at         DateTime @default(now())
  actorId    String?
  actor      User?    @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorName  String
  actorRole  String
  // Dotted verb: "call.log", "lead.update", "finance.income.create".
  action     String
  // Section key (sections.ts) - the founder's filter is "show me Pipeline", not "show me lead.*".
  section    String
  entityType String
  entityId   String
  // One human sentence, composed at the call site where the names are already loaded:
  // "Logged a call with Priya Sharma - SPOKE". The feed reads it verbatim, so the founder
  // never has to decode an id.
  summary    String
  // Optional structured detail: { before, after, changed: [...] } for edits, free shape otherwise.
  meta       Json?

  @@index([at])
  @@index([actorId, at])
  @@index([section, at])
  @@index([entityType, entityId])
  @@map("activity_log")
}

// ───────────────────────────── Resume Studio ─────────────────────────────
// Founder-configurable CV builder. A Resume stores its structured content as JSON
// (shape = ResumeData in src/lib/resume-types.ts); the founder's template - which
// sections show, in what order, styling and the ATS rubric - lives in
// AppSetting("resumeTemplateConfig"). Each Resume renders to DOCX and PDF, and can
// be reviewed against a target JD by the Claude API (keys-off seam in lib/anthropic.ts);
// each review is kept so the coach can re-run it as often as they like and compare.
// ownerUserId / leadId are soft references (no FK) to keep this module self-contained.

model Resume {
  id          String         @id @default(cuid())
  title       String
  language    String         @default("EN") // "EN" | "DE"
  data        Json // ResumeData
  ownerUserId String?
  ownerName   String? // denormalised creator name for the list
  leadId      String? // optional soft link to a CRM lead/contact
  /// ER v2 `STUDENT ||--o{ CV` (Track H). A real FK, unlike ownerUserId/leadId which stay
  /// soft references - a coach building a CV for a student needs it on the student's record,
  /// and "how many of our students have a CV" was previously unanswerable.
  studentId   String?
  student     Student?       @relation(fields: [studentId], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  reviews     ResumeReview[]

  @@index([ownerUserId])
  @@index([leadId])
  @@index([studentId])
  @@map("resume")
}

// One ATS review of a resume against a JD. provider = "ai" (Claude) or
// "deterministic" (the offline analyser fallback). result = structured findings JSON.
/// This model IS ER v2's `CV_JD_MATCH` (match_score + suggestions). Track H adds the optional
/// link to a reusable JobDescription; `jdText` STAYS as the frozen snapshot, because a JD can
/// be edited afterwards and the review must show what was actually matched against.
model ResumeReview {
  id           String   @id @default(cuid())
  resumeId     String
  resume       Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  jobDescriptionId String?
  jobDescription   JobDescription? @relation(fields: [jobDescriptionId], references: [id], onDelete: SetNull)
  jdText       String
  provider     String   @default("ai")
  model        String?
  scoreOverall Int      @default(0) // 0-100 ATS match
  result       Json
  createdAt    DateTime @default(now())

  @@index([resumeId])
  @@index([jobDescriptionId])
  @@map("resume_review")
}

// ═══════════════ Outreach Specialist SOP (Script_for_Outreach_Specialist.docx, Steps 1–23) ═══════
// The 23-step lead lifecycle: opt-in → WhatsApp intro → booking chase → BANT qualification →
// Disco confirmation → handoff to the Discovery Specialist → SSS confirmation.
//
// Design: the SOP is a HUMAN-EXECUTED process, so the engine's job is to say WHAT to send, to
// WHOM, WHEN - not to send behind the specialist's back. Every step materialises as an
// OutreachStepLog row with a rendered body the specialist can read, copy and mark sent. Admin can
// flip individual steps to auto-send (AppSetting "outreachConfig"); every step is manual by
// default. See src/lib/outreach-sop.ts (templates) and src/lib/outreach-engine.ts (the ladder).

/// One actionable SOP step. Each value is exactly one row per journey (see the @@unique on
/// OutreachStepLog), which is what makes the ladder idempotent - re-running the engine can never
/// double-send. Step 16's two required call attempts are separate values for the same reason.
enum OutreachStep {
  INTRO_WHATSAPP // Step 3  - immediately after opt-in (target <5 min)
  INTRO_EMAIL // Step 3b - the same welcome by email, so one ladder owns all of Step 1
  FIRST_CALL // Step 4  - call right after the intro message
  CHECK_1 // Step 5  - wait 2h, then run the Step 10 booking check
  FOLLOWUP_WHATSAPP // Step 6  - not booked at check 1
  FOLLOWUP_EMAIL // Step 6b - same trigger as Step 6, sent by email alongside it
  CHECK_2 // Step 7  - booking check at the 2-hour mark, measured from opt-in
  FOLLOWUP_WHATSAPP_2 // Step 7b - second WhatsApp chase, not booked at check 2
  CHECK_3 // Step 7c - booking check at the 3-hour mark, measured from opt-in
  FOLLOWUP_CALL // Step 8  - not booked at check 3; the telecaller rings
  FINAL_CHECK // Step 9  - final booking check; not booked → IGNORE + card to LOST
  BANT_QUALIFICATION // Step 11 - score the booking against the New BANT model
  KEY_METRICS_TRANSFER // Step 12 - transfer 6 fields + assign Touchpoint/Disco owners
  DISCO_WELCOME // Step 13 - on Qualified = YES/MAYBE, after the post-booking delay
  DISCO_WELCOME_EMAIL // Step 13b - the same welcome by email, same trigger
  DISCO_REJECT_MSG // Step 13c - Qualified = NO: the call is being cancelled (WhatsApp)
  DISCO_REJECT_EMAIL // Step 13d - Qualified = NO: the same notice by email
  DISCO_CONFIRM_1 // Step 14 - at least 36h before the disco call
  DISCO_CONFIRM_2 // Step 15 - at least 24h before, only if Step 14 got no reply
  DISCO_CONFIRM_CALL_1 // Step 16 - first of two required call attempts
  DISCO_CONFIRM_CALL_2 // Step 16 - second required call attempt
  DISCO_CANCEL_MSG // Step 16 - at least 12h before, only after both calls failed
  DISCO_CANCEL_EMAIL // Step 16b - the same cancellation notice by email
  DISCO_CANCEL // Step 17/18 - cancel the calendar appointment, mark the row RED
  SSS_CONFIRM_1 // Step 19 - at least 24h before the SSS call (carries the personalized video)
  SSS_CONFIRM_2 // Step 20 - at least 12h before, only if Step 19 got no reply
  SSS_CANCEL_MSG // Step 21 - at least 10h before, still unconfirmed
  SSS_CANCEL // Step 22/23 - cancel the SSS appointment, mark the row RED
}

/// Where a prospect sits in the SOP. Every branch in the SOP terminates in one of
/// IGNORED / CANCELLED / CLOSED_NOT_HQ / COMPLETED - there are no dead ends (checklist §S).
enum OutreachPhase {
  OPT_IN // Step 1–2: captured, not yet contacted
  BOOKING_CHASE // Steps 3–9: chasing the booking
  QUALIFICATION // Steps 11–12: booked, awaiting BANT + Key Metrics transfer
  DISCO_CONFIRMATION // Steps 13–16: qualified, chasing confirmation
  AWAITING_DISCO // confirmed; the Discovery Specialist runs the call
  HANDOFF // Step 18: disco done, awaiting the Highly Qualified verdict
  SSS_CONFIRMATION // Steps 19–22: HQ = YES, chasing SSS confirmation
  COMPLETED // SSS confirmed - the outreach process succeeded
  IGNORED // Step 9: never booked. Dormant, NOT deleted - stays in records
  CANCELLED // Step 17/22: appointment cancelled
  CLOSED_NOT_HQ // Step 18: Highly Qualified = NO - the outreach process ends here
}

/// The SOP's "Qualified" column. Derived from the BANT score by qualifiedFromBant(), which is the
/// single source of truth (src/lib/outreach-sop.ts) - YES → Step 13, MAYBE → Step 13, NO → Step 17.
enum QualifiedVerdict {
  YES // Qualified
  MAYBE // Cannot judge
  NO // Not qualified
}

enum OutreachStepStatus {
  DUE // materialised and waiting on the specialist (or the auto-sender)
  SENT // executed - renderedBody holds the exact text that went out
  SKIPPED // deliberately passed over (specialist chose to, or the branch closed)
  FAILED // auto-send attempted and the provider rejected it
  SUPERSEDED // overtaken by events (e.g. prospect confirmed before this reminder was due)
}

enum OutreachChannel {
  WHATSAPP
  CALL
  EMAIL // Step 6b - the booking chase also goes out by email, not WhatsApp alone
  SYSTEM // internal checks (Step 5/7/9/10) and calendar actions (Step 17/22)
}

/// One prospect's walk through the SOP. Exactly one per Lead. Holds the SOP's own columns - the
/// ones "Key Metrics Sales B2_2026.xlsx" carries and the CRM has no home for.
model OutreachJourney {
  id        String          @id @default(cuid())
  leadId    String          @unique
  lead      Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  // Set when the Step 10 cross-check matches this lead to a booking (by normalized email/phone).
  bookingId String?         @unique
  booking   BookingRequest? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  phase OutreachPhase @default(OPT_IN)

  // Step 1–2. optInAt is the SLA baseline; it mirrors Lead.createdAt but is held here so the
  // journey is self-contained and the clock can be corrected if a webhook replays late.
  optInAt     DateTime
  // Step 2's "Time Contacted" column. Stored as a UTC instant, entered and displayed in IST.
  contactedAt DateTime?

  // Step 11/12 - qualification. Auditable: who decided, when, and off which score (checklist §K).
  qualified       QualifiedVerdict?
  qualifiedAt     DateTime?
  qualifiedById   String?
  qualifiedBy     User?             @relation("OutreachQualifiedBy", fields: [qualifiedById], references: [id], onDelete: SetNull)
  bantScoreAtQual Float? // the bantAvg the verdict was taken on - survives a later re-tune

  // Step 12 - the two Key Metrics assignment dropdowns.
  respTouchpointId String?
  respTouchpoint   User?   @relation("OutreachRespTouchpoint", fields: [respTouchpointId], references: [id], onDelete: SetNull)
  respDiscoId      String?
  respDisco        User?   @relation("OutreachRespDisco", fields: [respDiscoId], references: [id], onDelete: SetNull)

  // Step 14/15 - the Key Metrics "WhatsApp Sent" / "WhatsApp Confirmed" columns.
  // sent flips on actual delivery, never on scheduling (checklist §N).
  whatsappSent        Boolean   @default(false)
  whatsappSentAt      DateTime?
  whatsappConfirmed   Boolean   @default(false)
  whatsappConfirmedAt DateTime?

  // Step 19/20 - the Key Metrics "Sales Call Confirmed" column.
  salesCallConfirmed   Boolean   @default(false)
  salesCallConfirmedAt DateTime?

  // Step 18 - written by the Discovery Specialist only (enforced in outreach-actions.ts).
  highlyQualified   Boolean?
  highlyQualifiedAt DateTime?

  // Step 19 - the SSS appointment instant (UTC), set when the Discovery Specialist books it.
  sssAt DateTime?

  // Cross-cutting - the Zoom link pulled from the Discovery Specialist's calendar (§R).
  zoomLink String?

  // Steps 16/18/21/23 - the "mark the row RED" flag. A presentation flag on its own field so it
  // can never silently overwrite a status column (checklist §N).
  redFlag       Boolean @default(false)
  redFlagReason String?

  ignoredAt    DateTime?
  cancelledAt  DateTime?
  cancelReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  steps   OutreachStepLog[]
  // The SSS slot this prospect is booked into (null unless an SSS is scheduled via the
  // calendar). journey.sssAt is kept in sync with the slot's startsAt so the SSS confirmation
  // ladder (steps 19–21, anchored on sssAt) keeps working through any reschedule.
  sssSlot SssSlot?          @relation("SssSlotJourney")

  @@index([phase])
  @@index([contactedAt])
  @@index([qualified])
  // The speed-to-lead report and the SLA reads scope by opt-in window across all ~23k journeys.
  // Without this they are a full scan of the table on every open.
  @@index([optInAt])
  @@map("outreach_journey")
}

/// One SOP step for one prospect. APPEND-ONLY in spirit: a row is created when the step becomes
/// due and is only ever transitioned DUE → SENT/SKIPPED/FAILED/SUPERSEDED.
///
/// The @@unique([journeyId, step]) is the idempotency guarantee the checklist asks for repeatedly
/// (§C "no duplicate sends", §F "doesn't resend if already sent once"). It is a DB constraint, not
/// a read-then-write check, so concurrent cron runs cannot both materialise the same step.
model OutreachStepLog {
  id        String          @id @default(cuid())
  journeyId String
  journey   OutreachJourney @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  step    OutreachStep
  status  OutreachStepStatus @default(DUE)
  channel OutreachChannel

  /// When the SOP says this step should happen. For the Disco/SSS ladders this is computed
  /// backward from the appointment instant (T-36h, T-24h, ...), not forward from enrollment.
  dueAt   DateTime
  actedAt DateTime?

  actedById String?
  actedBy   User?   @relation("OutreachStepActedBy", fields: [actedById], references: [id], onDelete: SetNull)

  /// The exact message text that went out, variables already resolved. This is the audit record -
  /// re-rendering later could differ if a template is edited, so we keep what was actually sent.
  renderedBody String?

  /// For CALL steps: the SOP's Yes/No branch outcome. For SYSTEM checks: the check result.
  outcome String?

  /// Set when a step auto-sends through WATI, so the log joins back to the delivery record.
  whatsAppMessageId String?

  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([journeyId, step])
  @@index([status, dueAt])
  @@index([journeyId])
  @@map("outreach_step_log")
}

/// GDPR consent (spec §15 + §19.1-C1: "nothing is stored without the user's consent").
///
/// The gate lives in the intake path, not here: `submitBooking` refuses to persist a Lead,
/// a BookingRequest or anything else until the prospect ticks the box, so a person who
/// declines leaves NO row behind - including no row in this table. A ConsentRecord therefore
/// only ever exists alongside the Lead it authorised, which is why `leadId` is required.
///
/// Recorded per spec: region (best-effort, from the form), timestamp, and the storage flag
/// (`granted`). `revokedAt` is the withdrawal half - GDPR consent is retractable, and a
/// withdrawal has to be provable after the fact, so it is stamped rather than deleted.
///
/// Distinct from WhatsAppOptOut, which is a post-hoc "stop messaging me" on a lead we already
/// hold. This is the prior question: were we allowed to hold them at all?
model ConsentRecord {
  id     String @id @default(cuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  /// The storage flag. A row is only written on a grant, so this is true in practice; it stays
  /// explicit so a future "declined but told us why" flow has somewhere honest to sit.
  granted       Boolean @default(true)
  /// What they agreed to, in the words shown on the form - the wording is the evidence.
  purpose       String
  /// Version of the privacy wording in force when they agreed, so a later policy change can
  /// never be mistaken for what THIS person consented to.
  policyVersion String?
  /// Best-effort jurisdiction (DE / IN / …) taken from the form's country/city answer.
  /// Nullable on purpose: a guessed region is worse than a missing one.
  region        String?
  source        Source  @default(BOOKING_FORM)

  /// Observed at grant time - the same pair the agreement e-sign trail captures.
  ipAddress String?
  userAgent String?

  grantedAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([leadId])
  @@index([grantedAt])
  @@map("consent_record")
}

/// Part 2 §13. SYSTEM follows the OS; the other two are a deliberate override.
enum ThemePreference {
  SYSTEM
  LIGHT
  DARK
}

/// Which timetable a joiner can actually attend (spec Part 2 §2.1: batches are keyed to the
/// student's chosen date/time). EITHER is the useful default - most people say "whatever
/// opens first", and pretending otherwise would strand them in the pool.
enum GnSlotPreference {
  WEEKDAY
  WEEKEND
  EITHER
}

/// The pending pool (spec Part 2 §2.2: "Hold unassigned single joiners in a pending pool
/// until a batch can be opened").
///
/// THE POINT: a workshop that yields one joiner must NOT open a batch - the founders wait
/// for the next workshop to accumulate enough people. That is why some workshops show no
/// batch assigned, and why batch numbers legitimately have gaps (§2.1). Without somewhere to
/// park that person they are simply forgotten, which is the manual process's actual failure.
///
/// A row here means "paid/committed, not yet seated". `assignedBatchId` is the exit: set when
/// they finally get a seat, which keeps the history of how long they waited rather than
/// deleting the evidence.
model GnPendingJoiner {
  id        String       @id @default(cuid())
  studentId String
  student   Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  level     String // Level.code (was ProgramLevel enum)

  preference    GnSlotPreference @default(EITHER)
  /// Free text, as captured on the confirmation call ("evening", "after 7pm").
  preferredTime String?
  /// Which workshop they came out of, so "this workshop produced 1 joiner" stays answerable.
  workshopId    String?
  workshop      Workshop?        @relation(fields: [workshopId], references: [id], onDelete: SetNull)
  notes         String?

  /// Exit fields. Null while waiting; stamped when seated.
  assignedBatchId String?
  assignedBatch   Batch?    @relation(fields: [assignedBatchId], references: [id], onDelete: SetNull)
  assignedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One live wait per student per level. A student seated in A1 may later wait for A2, so
  /// the uniqueness is per level rather than per student.
  @@unique([studentId, level])
  @@index([level, preference])
  @@index([assignedBatchId])
  @@map("gn_pending_joiner")
}

/// The book publisher (spec §9.2, Part 2 §4). Today the vendor is a free-text string on an
/// Expense row, so "what did we order from whom, and did it ship" is unanswerable.
model Vendor {
  id      String  @id @default(cuid())
  name    String
  phone   String?
  email   String?
  address String?
  notes   String?
  active  Boolean @default(true)

  orders    BookOrder[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@map("vendor")
}

/// Where a book order is in the publisher flow (spec §9.2 / Part 2 §4):
/// token advance → confirm level → vendor quotation → pay → courier.
enum BookOrderStatus {
  /// Held back because the student hasn't paid enough yet (EMI). The spec's default for
  /// anyone not paying a lump sum up front.
  DEFERRED
  /// Ready to order; we've asked the publisher for a price.
  QUOTE_REQUESTED
  QUOTED
  ORDERED
  PAID
  COURIERED
  CANCELLED
}

/// A physical book order for ONE level (spec §19.3: "BOOK_ORDER re-pointed to per-level
/// quotations: A1 first, fresh quote for A2"). Per level, not per contract - the founders
/// deliberately re-quote before each level rather than ordering a 3-level set up front.
///
/// Ordering trigger (Part 2 §4.4): a big up-front payment orders immediately; an EMI student
/// defers until they've paid enough. The threshold is config, not a constant here - the
/// spec's ₹30,000 is an example the founders gave, and §18.3 lists the precise figure as
/// still open.
model BookOrder {
  id        String       @id @default(cuid())
  studentId String
  student   Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  /// ER v2 `ENROLLMENT ||--o{ BOOK_ORDER` (Track E, decision D6). ADDITIVE - `studentId`
  /// stays and remains required. For a student on three German levels, "which level were
  /// these books for" was previously inferred from `level` alone; this makes it a link.
  /// Nullable because existing rows have no enrollment to point at, and the backfill leaves
  /// ambiguous matches null rather than guessing.
  enrollmentId String?
  enrollment   Enrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  level     String // Level.code (was ProgramLevel enum)
  vendorId  String?
  vendor    Vendor?      @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  /// Human-quotable reference, e.g. `BO-2026-0087` - the `{{order_ref}}` the approved WATI
  /// template sends to the publisher, and what the publisher quotes back at us. Deliberately not
  /// the cuid: a vendor has to be able to read it down a phone line.
  ///
  /// Nullable because rows created before this existed have none. It is allocated lazily on the
  /// first publisher message, so an order only takes a number once it is actually ordered -
  /// nothing burns a sequence number by being opened and cancelled.
  orderRef String? @unique

  status BookOrderStatus @default(DEFERRED)

  /// Money in integer paise, like every other amount in this schema.
  quotedAmountInrMinor BigInt?
  paidAmountInrMinor   BigInt?

  /// Snapshotted at order time, NOT read live off the Student: the books ship to where the
  /// student lived when we ordered, and a later address edit must not rewrite that history.
  shipToAddress String?
  shipToPhone   String?
  courierRef    String?

  /// Why we're holding - surfaced to the team so DEFERRED never reads as "forgotten".
  deferReason String?
  notes       String?

  quotedAt    DateTime?
  orderedAt   DateTime?
  paidAt      DateTime?
  courieredAt DateTime?

  /// Publisher messages sent about this order - what makes "have we actually told them?"
  /// answerable on the row instead of by trawling the WhatsApp log by phone number.
  messages WhatsAppMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One order per student per level; a re-order after a cancellation reuses the row.
  @@unique([studentId, level])
  @@index([status])
  @@index([vendorId])
  @@index([enrollmentId])
  @@map("book_order")
}

// ═══════════════════ ER v2 Track C - Tutor fees as a record ═══════════════════
//
// The RULE already existed and was tested (`lib/tutor-fee.ts`: rate = students >= 5 ? ₹7,000
// : ₹8,000, per level, per head). What did not exist was the RECORD, so "what did this
// trainer earn for this batch, and have we paid it" had no answer.
//
// This model persists the OUTPUT of that pure function. It does not re-implement it.

enum TutorFeeStatus {
  DRAFT // recomputed freely; a headcount change updates it in place
  APPROVED // founder signed off - frozen, and optionally accrued to the ledger
  PAID
  CANCELLED
}

model TutorFee {
  id        String  @id @default(cuid())
  batchId   String
  batch     Batch   @relation(fields: [batchId], references: [id], onDelete: Cascade)
  /// SetNull, like every other money-adjacent actor link: deleting a user must never delete
  /// the record of what they were owed.
  trainerId String?
  trainer   User?   @relation("TutorFeeEarner", fields: [trainerId], references: [id], onDelete: SetNull)
  level     String // Level.code, snapshotted off the batch at compute time

  /// SNAPSHOTS, not joins. A student joining next month must not silently re-price a fee the
  /// founder has already approved - the same reason Agreement.data and BookOrder.shipToAddress
  /// are frozen. `headcount` is also the evidence for WHY the ₹7,000 vs ₹8,000 band applied.
  headcount           Int
  ratePerHeadInrMinor BigInt
  amountInrMinor      BigInt

  /// Founder override for a genuine exception. Null = use `amountInrMinor`. A reason is
  /// required by the action when this is set - an unexplained override is indistinguishable
  /// from a typo six months later.
  overrideAmountInrMinor BigInt?
  overrideReason         String?

  status     TutorFeeStatus @default(DRAFT)
  computedAt DateTime       @default(now())
  approvedAt DateTime?
  paidAt     DateTime?
  /// The Dr COGS-tutor-fees / Cr Accounts-payable accrual, when
  /// `financePosting.tutorFeeAccrual` is on. Null = reported but not accrued.
  postedEntryId String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  /// One fee per batch per level (D3: the rate is per level per batch, not monthly). A batch
  /// running A1 then A2 produces two rows; a recompute updates the DRAFT one in place.
  @@unique([batchId, level])
  @@index([trainerId, status])
  @@index([status, computedAt])
  @@map("tutor_fee")
}

// ═════════════ ER v2 Track D - Configurable qualification questions ═════════════
//
// Was: 18 hardcoded columns on BookingRequest with the weights buried in lib/bant.ts, so the
// founders could not add, remove or reweight a question without shipping a migration - even
// though the resulting BANT verdict decides who gets called.
//
// D5 was answered VERSIONED. A question's wording and scoring are the evidence for why a
// verdict was taken; editing one in place would rewrite the reason we called someone months
// after the fact. An edit therefore creates version N+1 and leaves the answered version alone.

enum BantDimension {
  BUDGET
  AUTHORITY
  NEED
  TIMELINE
  NONE // asked for context, scores nothing
}

enum QuestionKind {
  TEXT
  LONG_TEXT
  SELECT
  MULTI_SELECT
  BOOLEAN
  NUMBER
}

model QualificationQuestion {
  id      String @id @default(cuid())
  /// Stable slug, deliberately equal to the existing BookingRequest column name
  /// ("readyToInvest", "decisionMaking", …) so the seed reproduces today's form exactly and
  /// the dual-write phase can map answers back to columns with no lookup table.
  key     String
  version Int    @default(1)

  text     String // the wording shown on the form - this IS the evidence
  helpText String?
  kind     QuestionKind  @default(SELECT)
  /// [{ value, label, score }] - score is the 0–5 weighted layer the BANT average is taken
  /// over. Null for free-text kinds, which score nothing.
  options  Json?
  /// ── INBOUND MAPPING ─────────────────────────────────────────────────────────────────
  /// How an EXTERNAL form's vocabulary is recognised as this question. Both founder-editable at
  /// Console → Qualification: the landing page posts its own field names and its own answer
  /// wording, and both change whenever marketing rewrites the page.
  ///
  /// DELIBERATELY NOT INSIDE `options`. The `qualification_question_version_guard` trigger
  /// treats `options` as immutable once answered - it is the evidence for a verdict already
  /// acted on - so an alias stored there could only be added by spawning a new question
  /// version. But recognising that the page now says "Right away" for an option that already
  /// meant `immediately` changes nothing about what was asked or what it scored; it is a
  /// parsing rule, not evidence. Keeping the two apart is what lets a mapping be fixed in place
  /// while the wording stays frozen.
  ///
  /// Field names this question may arrive under, e.g. ["when_start", "timeline"]. Matched case-
  /// and punctuation-insensitively, so "When_Start_Germany" and "when start germany" both hit
  /// without being listed. Empty means: match on the question `key` alone.
  inboundKeys String[] @default([])
  /// Answer texts per option: { "<option value>": ["Immediately", "Right away"] }. `value` and
  /// `label` are always accepted without being listed here.
  answerAliases Json?
  dimension BantDimension @default(NONE)
  weight    Int           @default(1)
  required  Boolean       @default(false)
  orderIndex Int          @default(0)
  /// Config tables retire, they do not delete - history points at them.
  active    Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  answers LeadAnswer[]

  @@unique([key, version])
  @@index([active, orderIndex])
  @@map("qualification_question")
}

model LeadAnswer {
  id               String  @id @default(cuid())
  leadId           String
  lead             Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  /// The submission this answer came in on. Nullable so an answer captured outside the
  /// booking form (a call, an import) still has a home.
  bookingRequestId String?
  bookingRequest   BookingRequest? @relation(fields: [bookingRequestId], references: [id], onDelete: Cascade)
  /// Points at a specific (key, version) - pinning WHICH wording was answered.
  questionId String
  question   QualificationQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)

  answerRaw String
  /// 0–5, resolved from `options` AT SUBMIT TIME. Stored rather than re-derived so a later
  /// reweight cannot retroactively change what this answer was worth.
  score     Int?
  createdAt DateTime @default(now())

  @@unique([bookingRequestId, questionId])
  @@index([leadId])
  @@index([questionId])
  @@map("lead_answer")
}

// ═════════ ER v2 Track F - Marketing source (campaign-level attribution) ═════════
//
// `LeadSource` is the CHANNEL taxonomy and stays exactly as it is. This adds the campaign
// beneath it, so "what did this campaign cost us per enrolled student" becomes answerable.
// `INSIGHT` is deliberately NOT a model - see server/insights-metrics.ts; it is a division.

model MarketingSource {
  id          String     @id @default(cuid())
  channel     LeadSource
  campaign    String
  /// Meta campaign id / UTM campaign value - the join key for imported spend.
  externalRef String?
  /// Which business this campaign sells. Null = both / unknown.
  line        BatchLine?
  active      Boolean    @default(true)
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  leads    Lead[]
  adSpends AdSpend[]

  @@unique([channel, campaign])
  @@index([active])
  @@map("marketing_source")
}

// ═════════════ ER v2 Track H - Job descriptions + CV linkage ═════════════

model JobDescription {
  id       String  @id @default(cuid())
  title    String
  company  String
  location String?
  url      String?
  language String  @default("EN")
  text     String
  active   Boolean @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  applications JobApplication[]
  reviews      ResumeReview[]

  @@index([active, createdAt])
  @@map("job_description")
}

// ═════════════ ER v2 Track I - Per-program milestones ═════════════
//
// The `Milestone` enum stays as the stable key and `MilestoneLog` stays as the append-only
// audit trail - nothing here weakens either. What this adds is the diagram's `target_day`,
// per program level, so the at-risk radar has a real deadline instead of a vibe.

enum MilestoneProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  ACHIEVED
}

model ProgramMilestone {
  id        String    @id @default(cuid())
  levelCode String // Level.code - per program, as the diagram asks
  key       Milestone // reuse the shipped 7-value enum rather than inventing a parallel one
  name      String
  targetDay Int // day-N of the 90/120-day tracker
  orderIndex Int      @default(0)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  progress MilestoneProgress[]

  @@unique([levelCode, key])
  @@index([levelCode, orderIndex])
  @@map("program_milestone")
}

model MilestoneProgress {
  id           String     @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  milestoneId  String
  milestone    ProgramMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  status       MilestoneProgressStatus @default(NOT_STARTED)
  achievedAt   DateTime?
  note         String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([enrollmentId, milestoneId])
  @@index([status])
  @@map("milestone_progress")
}
